# Avium beyond1q: system-domain wpa_supplicant (AIDL ISupplicant registers on
# /dev/binder; no vendor-AIDL bridge on this bp4a base). Installed to
# /system/etc/init/ via PRODUCT_COPY_FILES in common.mk.
service wpa_supplicant /system/bin/hw/wpa_supplicant_avium \
    -O/data/misc/wifi/avium_supplicant/sockets -dd \
    -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    user wifi
    group wifi net_raw net_admin
    capabilities NET_RAW NET_ADMIN
    disabled
    oneshot

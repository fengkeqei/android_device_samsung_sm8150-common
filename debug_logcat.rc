# Early persistent logcat so boot failures can be read from recovery.
on post-fs-data
    mkdir /data/misc/logd 0770 logd log
    start logcatd

# NOTE: the old "capture_composer" service that launched the composer with
# LD_DEBUG was removed: its malformed shell syntax (a stray '?' from the
# deprecation warning) and its post-fs-data start COMPETED with the real
# hwcomposer-2-4 service, corrupting hwcomposer's startup (v25 boot:
# "capture_composer ... exited with status 6").

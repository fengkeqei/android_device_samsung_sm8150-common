# ============================================================
# v113 ROM bring-up fixes (consolidated)
# ============================================================

# ---- 1. /metadata on tmpfs (it is a 0771 empty dir on the read-only
#         system partition, so every mkdir /metadata/* fails with EROFS) ----
on early-fs
    mount tmpfs tmpfs /metadata mode=0771,uid=0,gid=1000
    mkdir /metadata/vold 0700 root root
    mkdir /metadata/password_slots 0771 root system
    mkdir /metadata/bootstat 0750 system log
    mkdir /metadata/ota 0750 root system
    mkdir /metadata/ota/snapshots 0750 root system
    mkdir /metadata/watchdog 0770 root system
    mkdir /metadata/tradeinmode 0770 root system
    mkdir /metadata/staged-install 0770 root system
    mkdir /metadata/prefetch 0770 root system
    mkdir /metadata/gsi 0771 root system
    mkdir /metadata/aconfig 0775 root system
    mkdir /metadata/apex 0700 root system
    mkdir /metadata/avium 0770 system system
    restorecon_recursive /metadata

# ---- 2. USB gadget for adb (self-contained) ----
on boot
    mkdir /config 0755 root root
    mount configfs none /config
    write /sys/class/android_usb/android0/enable 0
    setprop sys.usb.configfs 1
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x04e8
    write /config/usb_gadget/g1/idProduct 0x6860
    write /config/usb_gadget/g1/bDeviceClass 0x00
    write /config/usb_gadget/g1/bMaxPacketSize0 0x40
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber RF8N32EV43X
    write /config/usb_gadget/g1/strings/0x409/manufacturer Samsung
    write /config/usb_gadget/g1/strings/0x409/product Android
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration mtp_adb
    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.mtp 0770 shell shell
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb
    setprop sys.usb.config mtp,adb

# ---- 3. bind the UDC after adbd has opened ep0 (ffs.adb must exist first,
#         otherwise the gadget cannot start: "failed to start g1: -19") ----
on property:init.svc.adbd=running
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC a600000.dwc3
    setprop sys.usb.state mtp,adb
    write /dev/kmsg "ROMFIX: UDC bound"

# ---- 4. GPU firmware labels (4.14 vfat has no context= support) ----
on post-fs-data
    restorecon -R /vendor/firmware_mnt
    restorecon -R /vendor/firmware-modem

# ---- 5. backlight (composer 2.1 has no brightness API) ----
on boot
    write /sys/class/backlight/panel0-backlight/brightness 20000

on post-fs-data
    write /sys/class/backlight/panel0-backlight/brightness 20000

on property:sys.boot_completed=1
    write /sys/class/backlight/panel0-backlight/brightness 30000
    write /sys/class/timed_output/vibrator/enable 300

# Audio
qcom.hw.aac.encoder=true

# Bluetooth
vendor.qcom.bluetooth.soc=cherokee
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.bt.aac_frm_ctl.enabled=true

# CNE
persist.vendor.cne.feature=1

# Detect DS/SS
import /mnt/vendor/efs/factory.prop
import /mnt/vendor/efs/telephony.prop

# Display
debug.sf.latch_unsignaled=1

# Google WFD settings
persist.debug.wfd.enable=1

# HWC for VDS
debug.sf.enable_hwc_vds=1

# Maximum number of HFP client connections
bt.max.hfpclient.connections=1

# MM modules
media.stagefright.enable-player=true
media.stagefright.enable-http=true
media.stagefright.enable-aac=true
media.stagefright.enable-qcp=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true
mmp.enable.3g2=true
media.aac_51_output_enabled=true
mm.enable.smoothstreaming=true

# Netflix custom property
ro.netflix.bsp_rev=Q855-16947-1

# Radio
persist.vendor.radio.atfwd.start=true

# Ril
ro.product_ship=true

# Voice path for PCM VoIP by default
use.voice.path.for.pcm.voip=true

# ZRAM
ro.vendor.qti.config.zram=true

# 13631487 is decimal sum of supported codecs in AAL
# codecs:(PARSER_)AAC AC3 AMR_NB AMR_WB ASF AVI DTS FLV 3GP 3G2 MKV MP2PS MP2TS MP3 OGG QCP WAV FLAC AIFF APE DSD MOV XVID
vendor.mm.enable.qcom_parser=63963135
persist.mm.enable.prefetch=true

# Persist logcat to /data/misc/logd so failures can be read from recovery
persist.logd.logpersistd=logcatd

# Adreno EGL/Vulkan driver selection (surfaceflinger aborts without these)
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno

# Fingerprint: read by the Samsung AIDL IFingerprint wrapper (hardware/samsung).
# type=udfps (QBT2000 under-display); location is x|y|radius in pixels for the
# 1440x3040 panel.
ro.vendor.fingerprint.type=udfps
ro.vendor.fingerprint.sensor_location=720|2650|150
ro.vendor.fingerprint.force_calibrate=true

# Samsung MDFPP keymaster path — REQUIRED for the fingerprint key chain
# (BAuth_GetK_From_KM in libbauthtzcommon reads these to pick the
# skeymast/SKM QSEE TA; without them it falls to the QTI keymaster64 path
# whose cmd 0x205 is rejected, and the sensor interrupt never arms).
# Stock vendor build.prop values (Round 71).
ro.hardware.keystore=mdfpp
ro.security.keystore.keytype=sak,gak,sgak
ro.hardware.keystore_desede=true

# Fingerprint: stock-style init requests issued after HAL open
# (INSTALL_TA=10001 / GET_SECURITY_LEVEL=30 / GET_TA_VERSION=10000).
# Part of the Round 71 key-chain fix combo.
vendor.fingerprint.init_requests=10000,30,10001

# Dual-SIM (SM-G9730). persist prop lives in /data — a data wipe drops it,
# so seed it from build.prop too (Round 71).
persist.vendor.radio.multisim.config=dsds
ro.vendor.selinux_permissive=1

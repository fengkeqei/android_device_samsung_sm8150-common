# Round-72 72-4: enforcing switch additions (batch 2)

# health HAL walks power_supply nodes
allow hal_health_default sysfs_battery:dir search;
allow hal_health_default sysfs:file { open read };

# netd helpers attach to rild sockets (netboost)
allow netutils_wrapper rild:fd use;
allow netutils_wrapper rild:fifo_file { read write };
allow netutils_wrapper rild:unix_stream_socket { read write };
allow netutils_wrapper rild:netlink_route_socket { read write };

# fingerprint HAL side channel to the QBT sensor device

# bluetooth HAL reads /proc node for chip power state
allow hal_bluetooth_default proc:file read;

# qcom init scripts chmod/chown sysfs nodes
allow vendor_qti_init_shell sysfs:file setattr;
allow vendor_qti_init_shell vendor_sysfs_msm_power:file setattr;

# radio reads an unlabeled node (misc samsung sysfs)
allow radio unlabeled:file read;

# Round-72 72-4 second pass: enforcing cold-boot leftovers
allow hal_health_default sysfs_battery:dir { search read };
allow hal_sensors_default sysfs_input:file { open read };
allow zygote self:capability kill;
allow hal_audio_default efs_file:dir search;

# Round-72 72-4c: enforcing pass 2 leftovers
allow hal_health_default sysfs:file getattr;
allow hal_health_default sysfs_battery:dir { search open read };
allow argosd vendor_sysfs_devicetree_soc:dir search;
allow hal_bluetooth_default proc:file { open read write };
allow hal_usb_default vendor_sysfs_usb_c:dir { search open read };
allow hal_usb_default sysfs_battery:dir search;
allow vendor_hal_gnss_qti sysfs_battery:dir search;
allow vendor_hal_gnss_qti sysfs:file { open write };
allow vendor_qti_init_shell sysfs_devices_system_cpu:file setattr;
allow vendor_hal_gnss_qti sysfs:file getattr;
# qseecomd (tee) proxies gatekeeper/weaver record storage in /data/vendor
allow tee vendor_data_file:dir { search open read write };
allow tee vendor_data_file:file rw_file_perms;
allow hal_fingerprint_default vendor_qbt_device:chr_file rw_file_perms;

# Round-72 72-4: AIDL ndk support libs installed at /vendor/lib64 root are
# same_process_hal_file; their read by HAL domains is dontaudited in the
# platform policy, which surfaced as "library not found" under enforcing.
allow hal_wifi_supplicant_default same_process_hal_file:file { open read getattr map };
allow hal_wifi_hostapd_default same_process_hal_file:file { open read getattr map };
allow hal_bluetooth_default same_process_hal_file:file { open read getattr map };
allow hal_camera_default same_process_hal_file:file { open read getattr map };
allow vendor_legacy_service same_process_hal_file:file { open read getattr map };
# BT rfkill power switch (relabeled to sysfs_bluetooth_writable via genfscon)
allow hal_bluetooth_default sysfs_bluetooth_writable:file rw_file_perms;
allow hal_bluetooth_default sysfs_bluetooth_writable:dir search;

# Round-72 72-4: catch-all domain for Samsung proprietary vendor services that
# stock ships without sepolicy domains (vibrator@2.2, authfw, hqm, tlc.*,
# thermal, wifi@2.0, ...). They used to fall into the init domain, which
# enforcing forbids. One shared permissive domain keeps the core platform
# enforcing while these daemons behave exactly as before; convert them to real
# domains (and drop the permissive statement) as each one gets audited.
type vendor_legacy_service, domain;
type vendor_legacy_service_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_legacy_service)

# userdebug/eng only: user builds strip permissive domains
permissive vendor_legacy_service;

allow vendor_legacy_service vendor_file:dir r_dir_perms;
allow vendor_legacy_service vendor_file:file { r_file_perms map execute_no_trans };
allow vendor_legacy_service system_lib_file:dir r_dir_perms;
allow vendor_legacy_service system_lib_file:file { r_file_perms map execute_no_trans };

# framework clients of the legacy Samsung HALs
binder_call(system_server, vendor_legacy_service)
binder_call(hwservicemanager, vendor_legacy_service)
binder_call(hal_audio_default, vendor_legacy_service)

# Round-72 72-4c: access map from the permissive-functional boot
allow vendor_legacy_service video_device:chr_file { open read write ioctl };
allow vendor_legacy_service gpu_device:chr_file { open read write ioctl map };
allow vendor_legacy_service vendor_camera_data_file:dir rw_dir_perms;
allow vendor_legacy_service vendor_camera_data_file:file create_file_perms;
allow vendor_legacy_service sysfs_vibrator:dir search;
allow vendor_legacy_service sysfs_vibrator:file { open read write };
binder_call(cameraserver, vendor_legacy_service)
binder_call(nfc, vendor_legacy_service)

# Round-72 72-4c pass 3: final residuals
allow vendor_legacy_service sysfs:dir search;
allow vendor_legacy_service sysfs:file { open read getattr };
allow vendor_legacy_service ion_device:chr_file { open read };
allow vendor_legacy_service shell:fd use;
allow vendor_legacy_service shell:fifo_file write;

# camera provider (in the legacy catch-all) drives the flash via sysfs and
# calls back into cameraserver for torch status
allow vendor_legacy_service sysfs_camera_writable:dir search;
allow vendor_legacy_service sysfs_camera_writable:file rw_file_perms;
binder_call(vendor_legacy_service, cameraserver)

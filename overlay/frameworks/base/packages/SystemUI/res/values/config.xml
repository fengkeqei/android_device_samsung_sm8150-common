<resources>
    <!-- Doze: does this device support STATE_DOZE?  -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Doze: does this device support STATE_DOZE_SUSPEND?  -->
    <bool name="doze_suspend_display_state_supported">false</bool>

    <!-- Color of the UDFPS pressed view. Transparent: the black block the
         default color draws over the sensor area looks wrong on the Samsung
         panel (Round 71; mirrors the exynos9820 reference). -->
    <color name="config_udfpsColor">#00ffffff</color>

    <!-- Round 72: enable framework dimming so the UDFPS icon (circle) is
         actually drawn on the keyguard/AOD overlay. With this false the
         overlay renders only a black fill (the "black block" report). -->
    <bool name="config_udfpsFrameworkDimming">true</bool>
</resources>

    <!-- v127: AIDL vibrator HAL (android.hardware.vibrator-service.example).
         The HIDL entry above is still declared and served by the Samsung blob
         (sec-vibrator-2-2), but Android 16's framework only talks AIDL:
         HalNativeHandler.java imports android.hardware.vibrator.IVibrator and
         IVibratorManager. Without these two blocks servicemanager rejects the
         AIDL service registration and it aborts:
           Could not find android.hardware.vibrator.IVibrator/default in the
           VINTF manifest. No alternative instances declared in VINTF.
           Check failed: status == STATUS_OK (status=-3, STATUS_OK=0)
         NOTE: the version here must be 4 to match the -V4-ndk the service
         links. Declaring it in a separate /vendor/etc/vintf/manifest/ fragment
         does NOT work: soong rewrites that fragment's <version> to the highest
         *frozen* aidl version (3), and libvintf then refuses the whole device
         manifest with
           Conflicting FqInstance: IVibrator/default (@4) ... vs (@3) ...
           NULL VINTF MANIFEST!: device
         so the declaration has to live here, in the main manifest. -->
    <hal format="aidl">
        <name>android.hardware.vibrator</name>
        <version>4</version>
        <fqname>IVibrator/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.vibrator</name>
        <version>4</version>
        <fqname>IVibratorManager/default</fqname>
    </hal>
    <!-- v127: sensor HAL. Samsung's android.hardware.sensors@2.0-service.multihal
         is packaged from the blob, and it loads every sensor successfully:
             I SensorsMultiHal: Loaded sensor: ...
         but registration is rejected without a manifest entry:
             E android.hardware.sensors@2.0-service.multihal:
               Failed to register Sensors HAL instance
         This shell is HIDL 2.0 (not AIDL) because that is what the Samsung HAL
         implements. Declared here rather than as a vintf_fragment so it cannot
         collide with the copy of this fragment under /vendor/etc/vintf/manifest. -->
    <hal format="hidl">
        <name>android.hardware.sensors</name>
        <transport>hwbinder</transport>
        <fqname>@2.0::ISensors/default</fqname>
    </hal>

    <!-- v128: AIDL radio HAL instances, served by

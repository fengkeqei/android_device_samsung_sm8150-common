    <!-- The Samsung rild registers @1.4::IRadio only (libril_sem.so has no
         1.5/1.6 refs); radio-library.compat is not part of this build, so the
         AIDL->HIDL compat adapter that would call V1_5::IRadio::getService()
         is absent and there is nothing to declare for it. Do NOT add @1.5 /
         @1.6 fqnames here: libvintf treats same-interface different-minor
         (1.4/1.5/1.6) in one <hal> as "Duplicated major version" and refuses
         to assemble the whole device manifest (vendorimage fails). ISap@1.2
         coexists fine because it is a different interface. -->
    <hal format="hidl" override="true">
        <name>android.hardware.radio</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::ISap/slot1</fqname>

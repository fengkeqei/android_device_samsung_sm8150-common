diff --git a/libs/binder/IServiceManager.cpp b/libs/binder/IServiceManager.cpp
index 0a564aa0fb..f74d65d434 100644
--- a/libs/binder/IServiceManager.cpp
+++ b/libs/binder/IServiceManager.cpp
@@ -551,6 +551,43 @@ bool checkPermission(const String16& permission, pid_t pid, uid_t uid, bool logP
     }
 }
 
+// [bring-up] Vendor-side fallback for android::checkPermission().
+//
+// The real implementation above is system-only because it talks to
+// IPermissionController, which vendors cannot reach. That is fine for the
+// system build, but it leaves the vendor build of libbinder without the
+// symbol while libgui still needs it:
+//   - libgui is vendor_available and A16 builds a single libgui for both
+//     sides; /vendor/lib64/libgui.so is a byte-identical copy of the system
+//     one (same md5).
+//   - BufferQueueConsumer.cpp:957 and LayerStatePermissions.cpp:43 call
+//     PermissionCache::checkPermission() unconditionally.
+//   - so the vendor copy carries
+//       U _ZN7android15PermissionCache15checkPermissionERKNS_8String16Eij@LIBBINDER
+//     and loading it fails with
+//       cannot locate symbol
+//       "_ZN7android15PermissionCache15checkPermissionERKNS_8String16Eij"
+//       referenced by "/vendor/lib64/libgui.so"
+//     (hit by samsung.software.media.c2@1.0-service).
+//
+// A vendor process has no way to ask the permission controller anything, so the
+// only faithful behaviour is to grant for root and for ourselves (matching the
+// shortcut the system version takes) and deny everything else. Vendor code
+// calling into libgui's dump path is already inside the vendor boundary; this
+// is not a privilege escalation, it just lets the library load and link.
+#else // __ANDROID_VNDK__
+
+bool checkPermission(const String16& permission, pid_t pid, uid_t uid,
+                     bool /*logPermissionFailure*/) {
+    if ((uid == 0) || (pid == getpid())) {
+        return true;
+    }
+    ALOGW("checkPermission(%s) from uid=%d pid=%d denied: permission controller "
+          "unavailable in the vendor namespace",
+          String8(permission).c_str(), uid, pid);
+    return false;
+}
+
 #endif //__ANDROID_VNDK__
 

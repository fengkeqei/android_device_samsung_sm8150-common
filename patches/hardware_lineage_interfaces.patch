diff --git a/light/Android.bp b/light/Android.bp
index 82efed2..7f59ae0 100644
--- a/light/Android.bp
+++ b/light/Android.bp
@@ -35,3 +35,39 @@ cc_binary {
         "android.hardware.light-V2-ndk",
     ],
 }
+
+// Avium beyond1q (v132al): SYSTEM variant. Same structural gap as keymint/power:
+// LightsService (system_server) calls waitForDeclaredService(ILights/default)
+// against the SYSTEM servicemanager and BLOCKS the boot thread (ANR-proven at
+// LightsService$VintfHalCache.get). The vendor variant registers on vndSM where
+// no bridge exists in this bp4a. sysfs paths are identical for both partitions.
+cc_binary {
+    name: "android.hardware.light-service.lineage.avium",
+    defaults: ["hidl_defaults"],
+    relative_install_path: "hw",
+    init_rc: ["android.hardware.light-service.lineage.avium.rc"],
+    cflags: select(soong_config_variable("lineagelight", "scan_for_backlight_devices"), {
+        true: ["-DSCAN_FOR_BACKLIGHT_DEVICES"],
+        default: [],
+    }) + select(soong_config_variable("lineagelight", "snap_rgb_to_pure"), {
+        true: ["-DSNAP_RGB_TO_PURE"],
+        default: [],
+    }),
+    srcs: [
+        "devices/BacklightDevice.cpp",
+        "devices/LedDevice.cpp",
+        "devices/RgbLedDevice.cpp",
+        "models/Color.cpp",
+        "models/State.cpp",
+        "Devices.cpp",
+        "Lights.cpp",
+        "Utils.cpp",
+        "service.cpp",
+    ],
+    local_include_dirs: ["."],
+    shared_libs: [
+        "libbase",
+        "libbinder_ndk",
+        "android.hardware.light-V2-ndk",
+    ],
+}

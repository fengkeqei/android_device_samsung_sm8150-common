@@ -2,6 +2,10 @@ service vendor.power /vendor/bin/hw/android.hardware.power-service-qti
     class hal
     user system
     group system
+    # Avium v132ak: DISABLED. It registers IPower/default on vndSM where the
+    # system-side PowerHalLoader cannot see it (no vendor-AIDL bridge in this
+    # bp4a). Superseded by /system/bin/hw/android.hardware.power-service.avium.
+    disabled
 
 on post-fs
     chmod 0664 /sys/devices/virtual/graphics/fb0/idle_time

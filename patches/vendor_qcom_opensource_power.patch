+// Avium v132bs system variant (re-created after BK rollback lost the v132bi
+// surgery). A16 bp4a has NO vendor->system AIDL bridge: a service registered
+// on the vendor servicemanager is invisible to system_server's
+// PowerHalLoader (getService2 only consults mTheRealServiceManager), so the
+// vendor-only android.hardware.power-service-qti leaves StartPowerManager in
+// a 1 s waitForService loop and boot never completes. This module is the same
+// implementation installed into /system/bin/hw, where it registers on the
+// system SM that PowerHalLoader actually consults. The vendor copy stays for
+// vendor-domain HIDL consumers (gnss@2.1-impl-qti power chain).
+cc_binary {
+    name: "android.hardware.power-service.avium",
+    defaults: [
+        "android.hardware.power-ndk_shared",
+    ],
+    init_rc: ["android.hardware.power-service.avium.rc"],
+    relative_install_path: "hw",
+
+
     cflags: [
         "-Wall",
         "-Wextra",

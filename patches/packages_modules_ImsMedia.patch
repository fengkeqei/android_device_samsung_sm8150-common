+void ImsMediaAudioPlayer::feedAec(const void* data, int32_t numFrames)
+{
+    if (mAudioStream == nullptr || data == nullptr || numFrames <= 0 || mSamplingRate <= 0)
+    {
+        return;
+    }
+    // The far-end reference must be fed before the samples reach the sink. The
+    // delay hint is how much audio is still buffered ahead in AAudio/HAL.
+    int32_t delayMs = 0;
+    const int64_t bufferedFrames = AAudioStream_getFramesWritten(mAudioStream) -
+            AAudioStream_getFramesRead(mAudioStream);
+    if (bufferedFrames > 0)
+    {
+        delayMs = static_cast<int32_t>(bufferedFrames * 1000 / mSamplingRate);
+    }
+    ImsMediaAec::GetInstance()->FeedFarEnd(
+            reinterpret_cast<const int16_t*>(data), numFrames, mSamplingRate, delayMs);
+}

+    // logd. init runs the service with stderr on /dev/null, and android::base
+    // defaults to stderr until InitLogging() redirects it to the log socket, so
+    // every LOG(INFO) in LegacyHAL (openHal results, init_requests, request())
+    // was silently dropped -- which made the fingerprint key chain
+    // undiagnosable. KernelLogger also mirrors to /dev/kmsg, which survives a
+    // logd restart.
+    android::base::InitLogging(argv, android::base::KernelLogger);
+
     ABinderProcess_setThreadPoolMaxThreadCount(0);
     std::shared_ptr<Fingerprint> fingerprint = ndk::SharedRefBase::make<Fingerprint>();
 
     const std::string instance = std::string() + Fingerprint::descriptor + "/default";
     binder_status_t status = AServiceManager_addService(fingerprint->asBinder().get(), instance.c_str());
-    CHECK(status == STATUS_OK);
+    // Avium beyond1q: never abort on a failed registration. A SIGABRT here is
+    // fatal for the whole device: init counts restarts, flags the service as
+    // UPDATABLE_CRASHING and then restarts every other updatable service
+    // (ril-daemon included), which tears down the modem link. The expected
+    // failure mode is -129 (EX_TRANSACTION_FAILED) when this vendor binary
+    // resolves the VNDK libbinder ("VNDR" parcel header) instead of the system
+    // one ("SYST"); the rc file pins LD_LIBRARY_PATH to fix exactly that on the
+    // next boot, so a soft failure here only means "HAL not up this boot".
+    if (status != STATUS_OK) {
+        LOG(ERROR) << "AServiceManager_addService(" << instance << ") failed: " << status

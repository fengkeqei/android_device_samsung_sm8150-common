@@ -15,6 +15,8 @@
 
 #include <dirent.h>
 #include <endian.h>
+#include <signal.h>
+
 #include <thread>
 
 using namespace ::android::fingerprint::samsung;
@@ -78,6 +80,16 @@ ndk::ScopedAStatus Session::enroll(const HardwareAuthToken& hat,
     // and a failed key negotiation (AuthHat_Decap_Key) must not wedge the
     // framework scheduler (WORKLOG Round 71 deadlock).
     std::thread([this, authToken]() {
+        // The vendor library blocks inside read(/dev/qbt2000_fd) while it
+        // waits for the sensor interrupt (TEE opcode WAIT_INTERRUPT). If any
+        // signal is delivered to this thread the read() fails with EINTR and
+        // the whole enroll aborts ("BAuthDeviceWaitInt sys call failed : 4").
+        // The thread is created from a binder thread whose mask only blocks
+        // one RT signal, so mask everything here.
+        sigset_t allSignals;
+        sigfillset(&allSignals);
+        pthread_sigmask(SIG_BLOCK, &allSignals, nullptr);
+
         if (FingerprintHalProperties::force_calibrate().value_or(false)) {
             mCaptureReady = false;
             mHal.request(SEM_REQUEST_FORCE_CBGE, 1);
@@ -91,14 +103,17 @@ ndk::ScopedAStatus Session::enroll(const HardwareAuthToken& hat,
         }
 
         if (FingerprintHalProperties::force_calibrate().value_or(false)) {
-            // bounded wait for the calibration capture (15s); capture-ready
-            // never arrives when the sensor interrupt enable failed.
+            // Bounded wait for the calibration capture. Do NOT abort the
+            // enrollment when it does not arrive: the TEE-side enroll is
+            // still armed and the framework's own timeout (60s in
+            // FingerprintEnrollClient) decides. Aborting here turned a slow
+            // first capture into an immediate "couldn't finish setup".
             for (int i = 0; i < 150 && !mCaptureReady; i++) {
                 std::this_thread::sleep_for(100ms);
             }
             if (!mCaptureReady) {
-                LOG(ERROR) << "calibration capture wait timed out";
-                mCb->onError(Error::UNABLE_TO_PROCESS, 0);
+                LOG(WARNING) << "calibration capture did not arrive within 15s;"
+                             << " leaving enrollment to the framework timeout";
             }
         }
     }).detach();
diff --git a/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.samsung.rc b/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.samsung.rc
index 1bfc073..a1956c5 100644
--- a/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.samsung.rc
+++ b/aidl/fingerprint/android.hardware.biometrics.fingerprint-service.samsung.rc
@@ -1,5 +1,19 @@
 service vendor.fingerprint-default /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.samsung
     class late_start
     user system
-    group system input uhid
+    # drmrpc (gid 1026) is REQUIRED: /dev/qseecom is system:drmrpc, and the
+    # Samsung fingerprint HAL opens it to start the authhat TA. Without the
+    # group the TA never starts, BAuth_GetK_From_KM falls back to a non-TEE
+    # key, and every enrollment dies with
+    #   E bauth_FPBAuthService: BAuth_Hat_OP fail rv : 28
+    group system input uhid drmrpc
     shutdown critical
+    # Avium beyond1q: this binary is built with vendor:true, but it must
+    # register its AIDL HAL on the SYSTEM servicemanager (/dev/binder) so that
+    # system_server can see IFingerprint/default. A vendor-built libbinder
+    # writes the "VNDR" parcel wire-format header, which the system
+    # servicemanager rejects ("Mixing copies of libbinder?" -> addService
+    # returns -129). Putting /system/lib64 first in the library search path
+    # makes the process resolve the system libbinder ("SYST" header) instead,
+    # and the HAL registers cleanly. Verified on device RF8N32EV43X.
+    env LD_LIBRARY_PATH /system/lib64:/vendor/lib64

diff --git a/ril/sehradiomanager/sehradiomanager.rc b/ril/sehradiomanager/sehradiomanager.rc
index 46d4247..68ebb2e 100644
--- a/ril/sehradiomanager/sehradiomanager.rc
+++ b/ril/sehradiomanager/sehradiomanager.rc
@@ -4,5 +4,38 @@ service vendor.sehradiomanager /vendor/bin/hw/sehradiomanager
     group radio
     disabled
 
+# Avium beyond1q: start as soon as rild has published ISehRadio, not at
+# sys.boot_completed.
+#
+# rild's SecRil::Init pushes internal request 111 and then calls
+# RIL_RegisterSehBridge, which creates the SehBridgeImpl and installs it in
+# sehBridgeService[]. The indication pointer inside that object only becomes
+# non-NULL once a client calls setResponseFunction, i.e. once this service has
+# run. Starting at boot_completed was far too late: rild begins emitting
+# secOemNoti unsolicited responses within ~400ms of init, so every one logged
+#   E RILC: secOemNoti: sehBridgeService[0]->mSehBridgeIndication == NULL
+# and the modem never received the vendor-side notifications it needs to start
+# a network search.
+#
+# DO NOT use `exec_start` here. exec_start runs the program to completion
+# synchronously and blocks init; this service is a long-running daemon (no
+# oneshot), so `on late-init exec_start vendor.sehradiomanager` wedges init
+# inside the late-init action forever. class_start main never runs, zygote is
+# never forked, and the device sits on the boot animation with no adb. That is
+# exactly what an earlier revision of this file caused.
+#
+# `start` is asynchronous and returns immediately, which is what a daemon
+# needs. `disabled` keeps it out of the class_start main batch so the two
+# property triggers below control the timing.
+#
+# on property:init.svc.ril-daemon=running fires as soon as rild has registered
+# its HIDL services, which is the earliest point ISehRadio/slot1 resolves.
+# The boot_completed trigger stays as a fallback.
+on property:init.svc.ril-daemon=running
+    start vendor.sehradiomanager
+
+on property:init.svc.ril-daemon1=running
+    start vendor.sehradiomanager
+
 on property:sys.boot_completed=1
     start vendor.sehradiomanager

diff --git a/src/include/openssl/bytestring.h b/src/include/openssl/bytestring.h
index d5df0b2f..5f536937 100644
--- a/src/include/openssl/bytestring.h
+++ b/src/include/openssl/bytestring.h
@@ -56,10 +56,19 @@ struct cbs_st {
 
 // CBS_init sets |cbs| to point to |data|. It does not take ownership of
 // |data|.
-OPENSSL_INLINE void CBS_init(CBS *cbs, const uint8_t *data, size_t len) {
-  cbs->data = data;
-  cbs->len = len;
-}
+//
+// [bring-up] Exported out-of-line instead of OPENSSL_INLINE. Pre-Android-12
+// vendor blobs were built against OpenSSL/early BoringSSL where CBS_init was a
+// real exported symbol; Samsung's libwvhidl.so binds it directly and the
+// widevine HAL dies at load time without it:
+//
+//   CANNOT LINK EXECUTABLE ".../android.hardware.drm@1.3-service.widevine":
+//   cannot locate symbol "CBS_init" referenced by "/vendor/lib/libwvhidl.so"
+//
+// Every other CBS_* symbol libwvhidl needs is already exported by
+// libcrypto.so; this was the only gap. Keeping the body out of line costs one
+// call per parse and lets old vendor code link again.
+OPENSSL_EXPORT void CBS_init(CBS *cbs, const uint8_t *data, size_t len);
 
 // CBS_skip advances |cbs| by |len| bytes. It returns one on success and zero
 // otherwise.

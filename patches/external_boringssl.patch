 OPENSSL_EXPORT OPENSSL_DEPRECATED size_t sk_push(OPENSSL_STACK *sk, void *p);
 OPENSSL_EXPORT OPENSSL_DEPRECATED void *sk_pop(OPENSSL_STACK *sk);
 
+// sk_delete is the legacy alias for |OPENSSL_sk_delete|. It was removed from
+// upstream BoringSSL but kept by some Android 12-era vendor blobs (Samsung
+// keymaster). Re-added for binary compatibility; returns the removed element.
+OPENSSL_EXPORT OPENSSL_DEPRECATED void *sk_delete(OPENSSL_STACK *sk,
+                                                  size_t where);

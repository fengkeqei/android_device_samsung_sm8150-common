@@ -345,6 +345,17 @@ int ASN1_INTEGER_get_int64(int64_t *out, const ASN1_INTEGER *a) {
   return asn1_string_get_int64(out, a, V_ASN1_INTEGER);
 }
 
+int ASN1_INTEGER_get_uint32(uint32_t *out, const ASN1_INTEGER *a) {
+  uint64_t v;
+  if (out == NULL || a == NULL ||
+      !asn1_string_get_uint64(&v, a, V_ASN1_INTEGER) ||
+      v > UINT32_MAX) {
+    return 0;
+  }
+  *out = static_cast<uint32_t>(v);
+  return 1;
+}
+
 int ASN1_ENUMERATED_get_int64(int64_t *out, const ASN1_ENUMERATED *a) {
   return asn1_string_get_int64(out, a, V_ASN1_ENUMERATED);
 }

+// Avium beyond1q: SYSTEM variant of wpa_supplicant. The AIDL ISupplicant
+// service registers on /dev/binder (no vendor-AIDL bridge on this bp4a base),
+// so it runs as the coredomain avium_supplicant domain. Links the system
+// libwpa_aidl_avium (keystore2 stubbed out) and drops libkeystore-engine-wifi-hidl
+// (vendor:true) + android.system.keystore2-V1-ndk (pulls vendor keymint).
+wpa_supplicant_cc_binary {
+    name: "wpa_supplicant_avium",
+    relative_install_path: "hw",
+    // Avium beyond1q: EVP_PKEY_from_keystore (libkeystore-engine, vendor:true)
+    // is stubbed by srcs/avium_keystore_stub.c below. Do NOT define
+    // MAINLINE_SUPPLICANT here: it pulls mainline_aidl_notify_usd_* symbols
+    // from aidl/mainline/callback_bridge which we do not ship.
+    srcs: [
+        "src/crypto/avium_keystore_stub.c",
+    ],
+    static_libs: [
+        "libwpa_aidl_avium",
+    ],
+    shared_libs: [
+        "libc",
+        "libcrypto",
+        "libcutils",
+        "liblog",
+        "libnl",
+        "libssl",
+    ] + [
+        "android.hardware.wifi.supplicant-V5-ndk",
+        "libbase",
+        "libbinder_ndk",
+        "libutils",
+    ],
+    defaults: [
+        "wpa_supplicant_srcs_default",
+        "wpa_supplicant_cflags_default",
+        "wpa_supplicant_includes_default",
+        "wpa_supplicant_usd_defaults",
+    ],
+    soong_config_variables: {
+        board_wpa_supplicant_private_lib: {
+            static_libs: ["%s"],
+        },
+    },
+}
+
 wpa_supplicant_cc_binary {
     name: "wpa_supplicant_macsec",
     proprietary: true,
@@ -1503,6 +1551,53 @@ cc_library_static {

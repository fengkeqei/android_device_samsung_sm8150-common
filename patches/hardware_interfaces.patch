+// Avium beyond1q: vendor-partition build of the same AIDL gatekeeper service.
+//
+// The APEX copy can never reach the Samsung MDFPP TEE gatekeeper: an APEX
+// binary's linker namespace has permitted_paths limited to the APEX, /system
+// and /system_ext, so /vendor/lib64/hw/gatekeeper.default.so is rejected even
+// when dlopen()ed by absolute path:
+//   W linker: library "/vendor/lib64/hw/gatekeeper.default.so" ... is not
+//   accessible for the namespace: [name="(default)",
+//   default_library_paths="/apex/com.android.hardware.gatekeeper/lib64",
+//   permitted_paths="/apex/.../lib64:/system/lib64:/system_ext/lib64"]
+// The software fallback then mints HATs with a non-TEE HMAC key and the
+// fingerprint trustlet rejects them, so enrollment always fails with
+//   E bauth_FPBAuthService: BAuth_Hat_OP fail rv : 28
+//   E bauth_FPBAuthService: enroll system fail BAuthSensorControl_DeviceEnableInt
+//
+// This copy installs to /vendor/bin/hw, runs in the vendor namespace that does
+// contain /vendor/${LIB}/hw, and can therefore open the patched TEE module
+// (gatekeeper.default.so -> libcrypto_gk + libQSEEComAPI). Its rc is the only
+// gatekeeper service definition on the device; the APEX one is not shipped.
+cc_binary {
+    name: "avium.gatekeeper-service.vendor",
+    cflags: [
+        "-fvisibility=hidden",
+        "-Wall",
+        "-Werror",
+    ],
+    relative_install_path: "hw",
+    shared_libs: [
+        "android.hardware.gatekeeper-V1-ndk",
+        "android.hardware.security.sharedsecret-V1-ndk",
+        "libbase",
+        "libbinder_ndk",
+        "libcrypto",
+        "libcutils",
+        "libgatekeeper",
+        "libhardware",
+        "libkeymaster_portable",
+        "liblog",
+        "libutils",
+    ],
+    srcs: [
+        "GateKeeper.cpp",
+        "SharedSecret.cpp",
+        "service.cpp",
+    ],
+    static_libs: ["libscrypt_static"],
+    vendor: true,
+    init_rc: ["avium.gatekeeper-service.vendor.rc"],
+    vintf_fragments: ["avium.gatekeeper-service.vendor.xml"],
+}
+

diff --git a/camera/device/1.0/default/CameraDeviceAbiCompat.cpp b/camera/device/1.0/default/CameraDeviceAbiCompat.cpp
new file mode 100644
index 0000000000..b22a819155
--- /dev/null
+++ b/camera/device/1.0/default/CameraDeviceAbiCompat.cpp
@@ -0,0 +1,66 @@
+// [bring-up] Emit the pre-Android-12 mangled name for CameraDevice's
+// constructor so Samsung's camera.provider@4.0-legacy.so can link.
+//
+// Background
+// ----------
+// CameraModule used to live in camera::common::V1_0::helper. Android 16 moved
+// it to camera::common::helper and left only a typedef alias in the old
+// namespace (hardware/interfaces/camera/common/default/include/CameraModule.h):
+//
+//   namespace V1_0::helper {
+//     typedef android::hardware::camera::common::helper::CameraModule CameraModule;
+//   }
+//
+// A typedef affects name mangling at compile time but emits no symbol, so
+// camera.device@1.0-impl.so exports the constructor only under
+//
+//   _ZN7android8hardware6camera6device4V1_014implementation12CameraDeviceC1E
+//   NS_2spINS1_6common6helper12CameraModuleEEE...
+//
+// while the Samsung blob binds
+//
+//   ...NS_2spINS1_6common4V1_06helper12CameraModuleEEE...
+//
+// and dies at load time:
+//
+//   CANNOT LINK EXECUTABLE "...camera.provider@4.0-service":
+//   cannot locate symbol _ZN7android8hardware6camera6device4V1_014implementation
+//   12CameraDeviceC1E...common4V1_06helper12CameraModule... referenced by
+//   "/vendor/lib/vendor.samsung.hardware.camera.provider@4.0-legacy.so"
+//
+// Why not a C++ overload or an alias attribute?
+// ---------------------------------------------
+// The typedef makes both spellings the *same* type, so a second constructor
+// taking the "old" namespace is literally a redeclaration of the first
+// ("error: constructor cannot be redeclared"). And __attribute__((alias)) only
+// works when the target is defined in the same translation unit, which it is
+// not (it lives in CameraDevice.cpp).
+//
+// What this file does
+// -------------------
+// Emits a two-instruction tail branch under the old mangled name. Both names
+// denote the same function with the same signature -- the typedef guarantees
+// it -- so the stub just forwards. All arguments of this constructor arrive in
+// registers (this, sp<CameraModule>, const string&, const SortedVector& =>
+// 4 pointer-sized values), so a bare branch preserves the entire call frame;
+// nothing needs to be spilled or reshuffled.
+
+#if defined(__aarch64__) || defined(__arm__)
+
+#define CTOR_NEW \
+  _ZN7android8hardware6camera6device4V1_014implementation12CameraDeviceC1ENS_2spINS1_6common6helper12CameraModuleEEERKNSt3__112basic_stringIcNSB_11char_traitsIcEENSB_9allocatorIcEEEERKNS_12SortedVectorINSB_4pairISH_SH_EEEE
+
+#define CTOR_OLD \
+  _ZN7android8hardware6camera6device4V1_014implementation12CameraDeviceC1ENS_2spINS1_6common4V1_06helper12CameraModuleEEERKNSt3__112basic_stringIcNSC_11char_traitsIcEENSC_9allocatorIcEEEERKNS_12SortedVectorINSC_4pairISI_SI_EEEE
+
+#define STR2(x) #x
+#define STR(x) STR2(x)
+
+asm(".text\n"
+    ".globl " STR(CTOR_OLD) "\n"
+    ".type " STR(CTOR_OLD) ", %function\n"
+    STR(CTOR_OLD) ":\n"
+    "  b " STR(CTOR_NEW) "\n"
+    ".size " STR(CTOR_OLD) ", .-" STR(CTOR_OLD) "\n");
+
+#endif

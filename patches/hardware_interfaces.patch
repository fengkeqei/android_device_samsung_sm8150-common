+static aidl::AccessTechnologySpecificInfo  //
+synthesizeLteVopsInfo(int32_t rat) {
+    if (RadioTechnology(rat) != RadioTechnology::LTE) return {};
+    using T = aidl::AccessTechnologySpecificInfo;
+    return T::make<T::Tag::eutranInfo>(aidl::EutranRegistrationInfo{
+            .lteVopsInfo = {.isVopsSupported = true, .isEmcBearerSupported = false},
+            .nrIndicators = {.isEndcAvailable = false, .isDcNrRestricted = false,
+                             .isNrAvailable = false},
+    });
+}
+
+aidl::RegStateResult toAidl(const V1_2::DataRegStateResult& res) {
+    return {
+            .regState = aidl::RegState(res.regState),
+            .rat = RadioTechnology(res.rat),
+            .reasonForDenial = aidl::RegistrationFailCause(res.reasonDataDenied),
+            .cellIdentity = toAidl(res.cellIdentity),
+            .registeredPlmn = "",
+            .accessTechnologySpecificInfo = synthesizeLteVopsInfo(res.rat),
+    };
+}
+
+aidl::RegStateResult toAidl(const V1_2::VoiceRegStateResult& res) {
+    return {
+            .regState = aidl::RegState(res.regState),
+            .rat = RadioTechnology(res.rat),
+            .reasonForDenial = aidl::RegistrationFailCause(res.reasonForDenial),
+            .cellIdentity = toAidl(res.cellIdentity),
+            .registeredPlmn = "",
+            .accessTechnologySpecificInfo = {},
+    };
+}
+
+// Samsung's rild answers the data query through the V1_4 callback (the
+// response carries V1_4::DataRegStateResult = V1_2 base + VopsInfo union),
+// even though the request came in as V1_2 — so this conversion is required
+// for the data registration state to ever reach the framework.
+aidl::RegStateResult toAidl(const V1_4::DataRegStateResult& res) {
+    auto ret = toAidl(res.base);
+    using Discr = V1_4::DataRegStateResult::VopsInfo::hidl_discriminator;
+    if (res.vopsInfo.getDiscriminator() == Discr::lteVopsInfo) {
+        ret.accessTechnologySpecificInfo = aidl::AccessTechnologySpecificInfo::make<
+                aidl::AccessTechnologySpecificInfo::Tag::eutranInfo>(
+                aidl::EutranRegistrationInfo{
+                        .lteVopsInfo = toAidl(res.vopsInfo.lteVopsInfo()),
+                        .nrIndicators = {.isEndcAvailable = false,
+                                         .isDcNrRestricted = false,
+                                         .isNrAvailable = false},
+                });
+    } else if (RadioTechnology(res.base.rat) == RadioTechnology::LTE) {
+        // LTE without vops info: synthesize so the framework does not mark
+        // the cell VoLTE-incapable (the vendor IMS stack is vops-capable).
+        ret.accessTechnologySpecificInfo = synthesizeLteVopsInfo(res.base.rat);
+    }
+    return ret;
+}

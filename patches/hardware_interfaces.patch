+#define LOG_TAG "AHAL_ModuleLegacy"
+
+#include <android-base/logging.h>
+
+#include "core-impl/ModuleLegacy.h"
+
+namespace aidl::android::hardware::audio::core {
+
+ndk::ScopedAStatus ModuleLegacy::setMicMute(bool in_mute) {
+    // beyond1q: Module::setMicMute only caches the flag. Telecom calls this when
+    // the user taps mute, so it must also reach the vendor blob, otherwise the
+    // IMS uplink keeps capturing the microphone while the UI shows "muted".
+    RETURN_STATUS_IF_ERROR(StreamLegacy::setLegacyMicMute(in_mute));
+    return Module::setMicMute(in_mute);
+}
+
+ndk::ScopedAStatus ModuleLegacy::createInputStream(
+        StreamContext&& context, const ::aidl::android::hardware::audio::common::SinkMetadata&
+                                         sinkMetadata,
+        const std::vector<::aidl::android::media::audio::common::MicrophoneInfo>& microphones,
+        std::shared_ptr<StreamIn>* result) {
+    if (!StreamLegacy::isHalAvailable() || context.isMmap() ||
+        context.getFormat().type != ::aidl::android::media::audio::common::AudioFormatType::PCM) {
+        LOG(INFO) << __func__ << ": legacy HAL unavailable, using the ALSA backend";
+        return ModulePrimary::createInputStream(std::move(context), sinkMetadata, microphones,
+                                                result);
+    }
+    LOG(INFO) << __func__ << ": creating legacy-backed input stream";
+    return createStreamInstance<StreamInLegacy>(result, std::move(context), sinkMetadata,
+                                                microphones);
+}
+
+ndk::ScopedAStatus ModuleLegacy::createOutputStream(
+        StreamContext&& context,
+        const ::aidl::android::hardware::audio::common::SourceMetadata& sourceMetadata,
+        const std::optional<::aidl::android::media::audio::common::AudioOffloadInfo>& offloadInfo,
+        std::shared_ptr<StreamOut>* result) {
+    if (!StreamLegacy::isHalAvailable() || context.isMmap() || offloadInfo.has_value() ||
+        context.getFormat().type != ::aidl::android::media::audio::common::AudioFormatType::PCM) {
+        LOG(WARNING) << __func__ << ": FALLBACK to ALSA (isHalAvailable=" << StreamLegacy::isHalAvailable() << ") "
+                  << "using the ALSA backend";
+        return ModulePrimary::createOutputStream(std::move(context), sourceMetadata, offloadInfo,
+                                                 result);
+    }
+    LOG(WARNING) << __func__ << ": creating LEGACY-backed output stream";
+    return createStreamInstance<StreamOutLegacy>(result, std::move(context), sourceMetadata,
+                                                 offloadInfo);
+}
+
+ndk::ScopedAStatus ModuleLegacy::populateConnectedDevicePort(
+        ::aidl::android::media::audio::common::AudioPort* audioPort, int32_t /*nextPortId*/) {
+    if (audioPort->ext.getTag() != ::aidl::android::media::audio::common::AudioPortExt::device) {
+        LOG(ERROR) << __func__ << ": not a device port: " << audioPort->toString();
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+    // Anything the vendor legacy HAL can drive is acceptable: analog wired
+    // headset/headphones today. Returning OK means "keep the template
+    // profiles as-is", which is exactly what we want — the vendor HAL
+    // switches its own mixer paths when the stream is opened with the
+    // corresponding legacy device.
+    LOG(INFO) << __func__ << ": accepting connected device port "
+              << audioPort->ext.get<::aidl::android::media::audio::common::AudioPortExt::device>()
+                         .device.toString();
+    return ndk::ScopedAStatus::ok();
+}
+
+}  // namespace aidl::android::hardware::audio::core

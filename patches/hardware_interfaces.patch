+using aidl::android::hardware::audio::common::getChannelCount;
+using aidl::android::media::audio::common::AudioDevice;
+using aidl::android::media::audio::common::AudioDeviceAddress;
+using aidl::android::media::audio::common::AudioDeviceDescription;
+using aidl::android::media::audio::common::AudioDeviceType;
+
+namespace aidl::android::hardware::audio::core {
+
+namespace {
+
+// io_handle must be unique per stream: the vendor HAL keys several internal
+// tables (adev_open_output_stream session routing) on it, and reusing 0 for
+// both the primary and the deep-buffer speaker stream makes the vendor HAL
+// route them onto the same PCM: the second stream's write() then fails and
+// the AIDL worker parks in state ERROR (observed as "no sound in players"
+// because media uses the DEEP_BUFFER path).
+std::atomic<int> gIoHandle{100};
+
+
+
+// One legacy HAL device per process, exactly like AudioFlinger used to do.
+// It is opened on first use and intentionally never closed: closing the
+// vendor HAL would release the DSP/ACDB state and the next open takes long
+// enough to be audible as a delay on the first playback.
+std::mutex gDeviceLock;
+audio_hw_device_t* gDevice = nullptr;
+
+audio_hw_device_t* getLegacyDevice() {
+    std::lock_guard<std::mutex> lock(gDeviceLock);
+    if (gDevice != nullptr) {
+        return gDevice;
+    }
+    const struct hw_module_t* module = nullptr;
+    // "audio.primary" resolves to audio.primary.<ro.product.board>.so, i.e.
+    // audio.primary.msmnile.so here.
+    int r = hw_get_module_by_class(AUDIO_HARDWARE_MODULE_ID, "primary", &module);
+    if (r != 0 || module == nullptr) {
+        LOG(ERROR) << __func__ << ": hw_get_module_by_class(audio.primary) failed: " << r;
+        return nullptr;
+    }
+    audio_hw_device_t* device = nullptr;
+    r = audio_hw_device_open(module, &device);
+    if (r != 0 || device == nullptr) {
+        LOG(ERROR) << __func__ << ": audio_hw_device_open failed: " << r;
+        return nullptr;
+    }
+    LOG(WARNING) << __func__ << ": opened legacy HAL " << module->name << " api=0x" << std::hex
+              << device->common.version;
+    gDevice = device;
+    return gDevice;
+}
+
+audio_devices_t mapDevice(const AudioDevice& device, bool isInput) {
+    const auto& desc = device.type;
+    switch (desc.type) {
+        case AudioDeviceType::OUT_SPEAKER:
+        case AudioDeviceType::OUT_SPEAKER_SAFE:
+            return AUDIO_DEVICE_OUT_SPEAKER;
+        case AudioDeviceType::OUT_SPEAKER_EARPIECE:
+            return AUDIO_DEVICE_OUT_EARPIECE;
+        case AudioDeviceType::OUT_HEADPHONE:
+            return AUDIO_DEVICE_OUT_WIRED_HEADPHONE;
+        case AudioDeviceType::OUT_HEADSET:
+            return AUDIO_DEVICE_OUT_WIRED_HEADSET;
+        case AudioDeviceType::OUT_HEARING_AID:
+            return AUDIO_DEVICE_OUT_HEARING_AID;
+        case AudioDeviceType::OUT_LINE_AUX:
+            return AUDIO_DEVICE_OUT_LINE;
+        case AudioDeviceType::OUT_DOCK:
+            return AUDIO_DEVICE_OUT_DGTL_DOCK_HEADSET;
+        case AudioDeviceType::OUT_FM:
+            return AUDIO_DEVICE_OUT_FM;
+        case AudioDeviceType::IN_MICROPHONE:
+            return AUDIO_DEVICE_IN_BUILTIN_MIC;
+        case AudioDeviceType::IN_MICROPHONE_BACK:
+            return AUDIO_DEVICE_IN_BACK_MIC;
+        case AudioDeviceType::IN_HEADSET:
+            return AUDIO_DEVICE_IN_WIRED_HEADSET;
+        case AudioDeviceType::IN_DOCK:
+            return AUDIO_DEVICE_IN_DGTL_DOCK_HEADSET;
+        case AudioDeviceType::IN_FM_TUNER:
+            return AUDIO_DEVICE_IN_FM_TUNER;
+        case AudioDeviceType::IN_TV_TUNER:
+            return AUDIO_DEVICE_IN_TV_TUNER;
+        default:
+            break;
+    }
+    // A16 models Bluetooth/USB/HDMI as a connection on a generic type.
+    if (desc.connection == AudioDeviceDescription::CONNECTION_BT_A2DP) {
+        return isInput ? AUDIO_DEVICE_IN_BLUETOOTH_A2DP : AUDIO_DEVICE_OUT_BLUETOOTH_A2DP;
+    }
+    if (desc.connection == AudioDeviceDescription::CONNECTION_BT_SCO) {
+        return isInput ? AUDIO_DEVICE_IN_BLUETOOTH_SCO_HEADSET
+                       : AUDIO_DEVICE_OUT_BLUETOOTH_SCO_HEADSET;
+    }
+    if (desc.connection == AudioDeviceDescription::CONNECTION_USB) {
+        return isInput ? AUDIO_DEVICE_IN_USB_HEADSET : AUDIO_DEVICE_OUT_USB_HEADSET;
+    }
+    return AUDIO_DEVICE_NONE;
+}
+
+audio_channel_mask_t channelMaskFor(size_t channelCount, bool isInput) {
+    if (channelCount == 1) {
+        return isInput ? AUDIO_CHANNEL_IN_MONO : AUDIO_CHANNEL_OUT_MONO;
+    }
+    return isInput ? AUDIO_CHANNEL_IN_STEREO : AUDIO_CHANNEL_OUT_STEREO;
+}
+
+}  // namespace
+
+StreamLegacy::StreamLegacy(StreamContext* context, const Metadata& metadata)
+    : StreamCommonImpl(context, metadata),
+      mIsInput(isInput(metadata)),
+      mFrameSizeBytes(context->getFrameSize()),
+      mSampleRate(context->getSampleRate()),
+      mChannelCount(getChannelCount(context->getChannelLayout())) {
+    // ModuleLegacy only sends PCM streams here; keep the conversion
+    // non-fatal anyway so a stray format cannot abort the HAL process.
+    const auto legacyFormat =
+            aidl2legacy_AudioFormatDescription_audio_format_t(context->getFormat());
+    mFormat = legacyFormat.has_value() ? legacyFormat.value() : AUDIO_FORMAT_INVALID;
+    mChannelMask = channelMaskFor(mChannelCount, mIsInput);
+    context->startStreamDataProcessor();
+}
+
+StreamLegacy::~StreamLegacy() {
+    shutdown();
+    cleanupWorker();
+}
+
+bool StreamLegacy::isHalAvailable() {
+    return getLegacyDevice() != nullptr;
+}
+
+::ndk::ScopedAStatus StreamLegacy::setLegacyMicMute(bool mute) {
+    audio_hw_device_t* dev = getLegacyDevice();
+    if (dev == nullptr || dev->set_mic_mute == nullptr) {
+        LOG(WARNING) << __func__ << ": legacy HAL has no set_mic_mute";
+        return ::ndk::ScopedAStatus::fromExceptionCode(EX_UNSUPPORTED_OPERATION);
+    }
+    const int r = dev->set_mic_mute(dev, mute);
+    LOG(INFO) << __func__ << ": mute=" << mute << " ret=" << r;
+    return r == 0 ? ::ndk::ScopedAStatus::ok()
+                  : ::ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+}
+
+::android::status_t StreamLegacy::init(DriverCallbackInterface* /*callback*/) {
+    return ::android::OK;
+}
+
+::android::status_t StreamLegacy::start() {
+    std::lock_guard<std::mutex> lock(mLock);
+    mPending.clear();  // drop stale tail so resume does not pop
+    if (mOut != nullptr || mIn != nullptr) {
+        return ::android::OK;  // resume after standby
+    }
+    return openStreamLocked() ? ::android::OK : ::android::INVALID_OPERATION;
+}
+
+bool StreamLegacy::openStreamLocked() {
+    if (mDev == nullptr) {
+        mDev = getLegacyDevice();
+        if (mDev == nullptr) {
+            return false;
+        }
+    }
+    mCurrentDevice = getDeviceTypeLocked();
+    const std::string address = getDeviceAddressLocked();
+    struct audio_config config = {};
+    config.sample_rate = static_cast<uint32_t>(mSampleRate);
+    config.channel_mask = mChannelMask;
+    config.format = mFormat;
+
+    int r;
+    if (mIsInput) {
+        // The Samsung HAL strlcpy()s the address without a NULL check
+        // (update_device_list), so this must be a real string.
+        //
+        // beyond1q: pass AUDIO_SOURCE_MIC, not AUDIO_SOURCE_DEFAULT. The
+        // legacy blob routes capture devices by source: its
+        // platform_get_input_snd_device() has no branch for
+        // AUDIO_SOURCE_DEFAULT, so select_devices() came back with
+        // snd_device=0 ("platform_add_backend_name: Invalid snd_device = 0",
+        // "pcm_prepare returned -1") and every recording start failed while
+        // the vendor HAL kept retrying. The HIDL wrapper used on A15 passed
+        // the application's real source, which is why recording worked
+        // there. A16's AIDL HAL dropped the source from the interface, and
+        // this wrapper hardcoded DEFAULT.
+        // Forward the real input flags (VOIP_TX in particular): AudioPolicy
+        // Manager tags AUDIO_SOURCE_VOICE_COMMUNICATION captures with
+        // AUDIO_INPUT_FLAG_VOIP_TX, and the vendor HAL maps that flag to its
+        // dedicated VoIP front-end. With INPUT_FLAG_NONE the IMS uplink ran
+        // through the plain audio-record path and the far end heard silence
+        // (A15 WORKLOG 71h..71z hit the same thing and fixed it by declaring
+        // a voip_tx mixPort in the policy).
+        audio_input_flags_t inFlags = AUDIO_INPUT_FLAG_NONE;
+        {
+            const auto& ioFlags = getContext().getFlags();
+            if (ioFlags.getTag() ==
+                    ::aidl::android::media::audio::common::AudioIoFlags::Tag::input) {
+                const int requested = ioFlags
+                        .get<::aidl::android::media::audio::common::AudioIoFlags::input>();
+                if (requested != 0) {
+                    inFlags = static_cast<audio_input_flags_t>(requested);
+                }
+            }
+        }
+        // beyond1q: the vendor HAL picks its VoIP TX usecase only when the
+        // source is VOICE_COMMUNICATION *and* AUDIO_INPUT_FLAG_VOIP_TX is
+        // set (audio_hw.c: "in->source == AUDIO_SOURCE_VOICE_COMMUNICATION &&
+        // !compress_voip && in->flags & AUDIO_INPUT_FLAG_VOIP_TX && mono &&
+        // rate in 8/16/32/48k"). AIDL has no source field, so derive it from
+        // the flags APM already set for us.
+        audio_source_t inSource = AUDIO_SOURCE_MIC;
+        if (inFlags & AUDIO_INPUT_FLAG_VOIP_TX) {
+            inSource = AUDIO_SOURCE_VOICE_COMMUNICATION;
+        }
+        r = mDev->open_input_stream(mDev, gIoHandle++ /* unique handle */, mCurrentDevice,
+                                    &config, &mIn,
+                                    inFlags, address.c_str(),
+                                    inSource);
+        if (r != 0 || mIn == nullptr) {
+            LOG(ERROR) << __func__ << ": open_input_stream(0x" << std::hex
+                       << static_cast<uint32_t>(mCurrentDevice) << ") failed: " << std::dec << r;
+            mIn = nullptr;
+            return false;
+        }
+        if (mIn->set_gain != nullptr) {
+            mIn->set_gain(mIn, mGain);
+        }
+        LOG(INFO) << __func__ << ": input stream opened, device=0x" << std::hex
+                  << static_cast<uint32_t>(mCurrentDevice) << " rate=" << std::dec
+                  << config.sample_rate << " mask=0x" << std::hex
+                  << static_cast<uint32_t>(config.channel_mask) << " format=0x"
+                  << static_cast<uint32_t>(config.format);
+    } else {
+        // Forward the real output flags (PRIMARY vs DEEP_BUFFER vs FAST):
+        // the vendor HAL maps different flags to different front-ends
+        // (MultiMedia1 vs MultiMedia30). Hardcoding PRIMARY made every
+        // stream collide on one front-end.
+        const auto& ioFlags = getContext().getFlags();
+        audio_output_flags_t outFlags = AUDIO_OUTPUT_FLAG_PRIMARY;
+        if (ioFlags.getTag() ==
+                ::aidl::android::media::audio::common::AudioIoFlags::Tag::output) {
+            // AudioIoFlags::output is a plain int bitfield (AudioOutputFlags),
+            // not a struct — get<TAG>() yields the flags directly.
+            const int requested = ioFlags
+                    .get<::aidl::android::media::audio::common::AudioIoFlags::output>();
+            if (requested != 0) {
+                outFlags = static_cast<audio_output_flags_t>(requested);
+            }
+        }
+        // Same as above: the HAL dereferences the address unconditionally.
+        r = mDev->open_output_stream(mDev, gIoHandle++ /* unique handle */, mCurrentDevice,
+                                     outFlags, &config, &mOut,
+                                     "" /* address */);
+        if (r != 0 || mOut == nullptr) {
+            LOG(ERROR) << __func__ << ": open_output_stream(0x" << std::hex
+                       << static_cast<uint32_t>(mCurrentDevice) << ") failed: " << std::dec << r;
+            mOut = nullptr;
+            return false;
+        }
+        if (mOut->set_volume != nullptr) {
+            mOut->set_volume(mOut, mGain, mGain);
+        }
+        // get_buffer_size() returns FRAMES. The Samsung HAL checks every
+        // write() against its own FIFO chunk in BYTES
+        // (sec_is_expected_buffer_size "expected_bytes 3840" == 960 frames
+        // * 2ch * 16bit); writing anything else makes it drop data silently
+        // and the output crackles. Derive the chunk once, in bytes.
+        if (mOut->common.get_buffer_size != nullptr) {
+            const size_t raw = mOut->common.get_buffer_size(&mOut->common);
+            // Legacy HALs disagree on the unit: AOSP audio_hw.c returns the
+            // PERIOD in bytes, the header doc says frames. Accept either:
+            // if raw*frameSize is a plausible chunk use that, else use raw.
+            const size_t asFrames = raw * mFrameSizeBytes;
+            size_t chunk = raw;
+            if (asFrames <= (1u << 16) && (raw % mFrameSizeBytes) != 0) {
+                chunk = asFrames;
+            }
+            mWriteChunkBytes = chunk >= mFrameSizeBytes ? chunk : 0;
+            LOG(WARNING) << __func__ << ": buffer_size raw=" << raw
+                         << " frameSize=" << mFrameSizeBytes
+                         << " -> chunk=" << mWriteChunkBytes;
+        }
+        LOG(WARNING) << __func__ << ": output stream opened, device=0x" << std::hex
+                  << static_cast<uint32_t>(mCurrentDevice) << " rate=" << std::dec
+                  << config.sample_rate << " mask=0x" << std::hex
+                  << static_cast<uint32_t>(config.channel_mask) << " format=0x"
+                  << static_cast<uint32_t>(config.format);
+    }
+    return true;
+}
+
+void StreamLegacy::closeStreamLocked() {
+    if (mDev == nullptr) {
+        return;
+    }
+    if (mOut != nullptr) {
+        mOut->common.standby(&mOut->common);
+        mDev->close_output_stream(mDev, mOut);
+        mOut = nullptr;
+    }
+    if (mIn != nullptr) {
+        mIn->common.standby(&mIn->common);
+        mDev->close_input_stream(mDev, mIn);
+        mIn = nullptr;
+    }
+    mCurrentDevice = AUDIO_DEVICE_NONE;
+}
+
+audio_devices_t StreamLegacy::getDeviceTypeLocked() const {
+    for (const auto& device : getConnectedDevices()) {
+        const audio_devices_t type = mapDevice(device, mIsInput);
+        if (type != AUDIO_DEVICE_NONE) {
+            return type;
+        }
+    }
+    return mIsInput ? AUDIO_DEVICE_IN_BUILTIN_MIC : AUDIO_DEVICE_OUT_SPEAKER;
+}
+
+std::string StreamLegacy::getDeviceAddressLocked() const {
+    // Keep the address paired with the device type that getDeviceTypeLocked()
+    // picks, so e.g. a wired headset mic is opened with its card/device
+    // address and the SCO mic with "bt-sco".
+    for (const auto& device : getConnectedDevices()) {
+        if (mapDevice(device, mIsInput) != AUDIO_DEVICE_NONE) {
+            const auto& addr = device.address;
+            if (addr.getTag() == AudioDeviceAddress::Tag::id) {
+                return addr.get<AudioDeviceAddress::Tag::id>();
+            }
+            if (addr.getTag() == AudioDeviceAddress::Tag::mac) {
+                const auto& mac = addr.get<AudioDeviceAddress::Tag::mac>();
+                if (mac.size() == 6) {
+                    char buf[18] = {};
+                    snprintf(buf, sizeof(buf), "%02x:%02x:%02x:%02x:%02x:%02x",
+                             mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+                    return buf;
+                }
+            }
+            return {};
+        }
+    }
+    return {};
+}
+
+::android::status_t StreamLegacy::drain(StreamDescriptor::DrainMode /*mode*/) {
+    if (!mIsInput) {
+        const size_t bufferFrames = getContext().getBufferSizeInFrames();
+        if (bufferFrames > 0 && mSampleRate > 0) {
+            usleep(static_cast<useconds_t>(bufferFrames * 1000000ULL / mSampleRate));
+        }
+    }
+    return ::android::OK;
+}
+
+::android::status_t StreamLegacy::flush() {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (!mIsInput && mOut != nullptr && mOut->flush != nullptr) {
+        mOut->flush(mOut);
+    }
+    return ::android::OK;
+}
+
+::android::status_t StreamLegacy::pause() {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (!mIsInput && mOut != nullptr && mOut->pause != nullptr) {
+        mOut->pause(mOut);
+    }
+    return ::android::OK;
+}
+
+::android::status_t StreamLegacy::standby() {
+    std::lock_guard<std::mutex> lock(mLock);
+    mPending.clear();  // drop stale tail so resume does not pop
+    if (mOut != nullptr) {
+        mOut->common.standby(&mOut->common);
+    }
+    if (mIn != nullptr) {
+        mIn->common.standby(&mIn->common);
+    }
+    return ::android::OK;
+}
+
+::android::status_t StreamLegacy::transfer(void* buffer, size_t frameCount,
+                                           size_t* actualFrameCount, int32_t* latencyMs) {
+    std::lock_guard<std::mutex> lock(mLock);
+    const size_t bytes = frameCount * mFrameSizeBytes;
+    if (mIsInput) {
+        if (mIn == nullptr) {
+            return ::android::INVALID_OPERATION;
+        }
+        const ssize_t r = mIn->read(mIn, buffer, bytes);
+        if (r < 0) {
+            LOG(WARNING) << __func__ << ": input read failed: " << r;
+            return ::android::INVALID_OPERATION;
+        }
+        *actualFrameCount = static_cast<size_t>(r) / mFrameSizeBytes;
+        *latencyMs = 0;
+        return ::android::OK;
+    }
+    if (mOut == nullptr) {
+        return ::android::INVALID_OPERATION;
+    }
+    // The Samsung HAL validates each write against its internal FIFO chunk
+    // (sec_is_expected_buffer_size: "bytes 16384 != expected_bytes 3840")
+    // and silently refuses oversized ones, leaving the PCM stuck in
+    // PREPARED. Legacy AudioFlinger wrote exactly get_buffer_size() bytes
+    // per cycle; replicate that by chunking the AIDL worker's burst.
+    // The HAL only accepts writes of exactly its FIFO chunk (3840 bytes
+    // here). AIDL bursts are 16384 bytes = 4*3840 + 1024, so the trailing
+    // 1024-byte fragment was being dropped every cycle -> crackle. Buffer
+    // the fragment and prepend it to the next burst so every write() is a
+    // full chunk.
+    const char* src = static_cast<const char*>(buffer);
+    size_t remaining = bytes;
+    if (mWriteChunkBytes != 0) {
+        mPending.insert(mPending.end(), src, src + remaining);
+        src = nullptr;
+        remaining = 0;
+        const char* p = mPending.data();
+        size_t avail = mPending.size();
+        while (avail >= mWriteChunkBytes) {
+            const ssize_t r = mOut->write(mOut, const_cast<char*>(p), mWriteChunkBytes);
+            if (r != static_cast<ssize_t>(mWriteChunkBytes)) {
+                LOG(WARNING) << __func__ << ": output write failed: " << r
+                             << " (want " << mWriteChunkBytes << ")";
+                if (r < 0) {
+                    mPending.clear();
+                    return ::android::INVALID_OPERATION;
+                }
+                // Keep whatever was not consumed; stop for this cycle.
+                mPending.erase(mPending.begin(),
+                               mPending.begin() + (r > 0 ? r : 0));
+                *actualFrameCount = bytes / mFrameSizeBytes;
+                *latencyMs = mOut->get_latency != nullptr
+                        ? static_cast<int32_t>(mOut->get_latency(mOut)) : 0;
+                return ::android::OK;
+            }
+            p += mWriteChunkBytes;
+            avail -= mWriteChunkBytes;
+        }
+        mPending.erase(mPending.begin(), mPending.begin() + (mPending.size() - avail));
+    } else {
+        while (remaining >= mFrameSizeBytes) {
+            const ssize_t r = mOut->write(mOut, const_cast<char*>(src), remaining);
+            if (r <= 0) {
+                LOG(WARNING) << __func__ << ": output write failed: " << r;
+                if (remaining == bytes) {
+                    return ::android::INVALID_OPERATION;
+                }
+                break;
+            }
+            src += r;
+            remaining -= static_cast<size_t>(r);
+        }
+    }
+    *actualFrameCount = bytes / mFrameSizeBytes;
+
+    *latencyMs = mOut->get_latency != nullptr ? static_cast<int32_t>(mOut->get_latency(mOut)) : 0;
+    return ::android::OK;
+}
+
+::android::status_t StreamLegacy::refinePosition(StreamDescriptor::Position* position) {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mIsInput || mOut == nullptr || mOut->get_presentation_position == nullptr) {
+        return ::android::OK;
+    }
+    uint64_t frames = 0;
+    struct timespec timestamp = {};
+    if (mOut->get_presentation_position(mOut, &frames, &timestamp) == 0) {
+        position->frames = static_cast<int64_t>(frames);
+        position->timeNs = static_cast<int64_t>(timestamp.tv_sec) * 1000000000LL +
+                           static_cast<int64_t>(timestamp.tv_nsec);
+    }
+    return ::android::OK;
+}
+
+void StreamLegacy::shutdown() {
+    std::lock_guard<std::mutex> lock(mLock);
+    closeStreamLocked();
+}
+
+ndk::ScopedAStatus StreamLegacy::setGain(float gain) {
+    std::lock_guard<std::mutex> lock(mLock);
+    mGain = gain;
+    if (mOut != nullptr && mOut->set_volume != nullptr) {
+        mOut->set_volume(mOut, gain, gain);
+    }
+    if (mIn != nullptr && mIn->set_gain != nullptr) {
+        mIn->set_gain(mIn, gain);
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus StreamLegacy::setConnectedDevices(const ConnectedDevices& devices) {
+    ndk::ScopedAStatus status = StreamCommonImpl::setConnectedDevices(devices);
+    if (!status.isOk()) {
+        return status;
+    }
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mOut == nullptr && mIn == nullptr) {
+        return ndk::ScopedAStatus::ok();
+    }
+    const audio_devices_t wanted = getDeviceTypeLocked();
+    if (wanted != mCurrentDevice) {
+        LOG(INFO) << __func__ << ": device change 0x" << std::hex
+                  << static_cast<uint32_t>(mCurrentDevice) << " -> 0x"
+                  << static_cast<uint32_t>(wanted) << ", reopening stream";
+        closeStreamLocked();
+        openStreamLocked();
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+}  // namespace aidl::android::hardware::audio::core

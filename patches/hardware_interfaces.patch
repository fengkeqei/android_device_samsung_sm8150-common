+
+#pragma once
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "ModulePrimary.h"
+#include "Stream.h"
+#include "StreamLegacy.h"
+
+namespace aidl::android::hardware::audio::core {
+
+// [bring-up] Primary module that prefers the vendor legacy HAL for PCM
+// streams.  Streams that the legacy path cannot handle (mmap, offload) are
+// created by the regular AOSP ALSA implementation inherited from
+// ModulePrimary, so a failure of the vendor blob never leaves the device
+// without an audio HAL at all.
+class ModuleLegacy : public ModulePrimary {
+  public:
+    ModuleLegacy(std::unique_ptr<Configuration>&& config)
+        : ModulePrimary(std::move(config)) {}
+
+  public:
+    ndk::ScopedAStatus setMicMute(bool in_mute) override;
+
+  protected:
+    ndk::ScopedAStatus createInputStream(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SinkMetadata& sinkMetadata,
+            const std::vector<::aidl::android::media::audio::common::MicrophoneInfo>& microphones,
+            std::shared_ptr<StreamIn>* result) override;
+    ndk::ScopedAStatus createOutputStream(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SourceMetadata& sourceMetadata,
+            const std::optional<::aidl::android::media::audio::common::AudioOffloadInfo>&
+                    offloadInfo,
+            std::shared_ptr<StreamOut>* result) override;
+
+    // [bring-up] Accept device ports that carry a `connection` descriptor
+    // (analog headset, and anything else the vendor HAL handles itself).
+    // The base Module implementation refuses them with EX_ILLEGAL_STATE and
+    // demands an override; without it `setDeviceConnectionState` for
+    // AUDIO_DEVICE_OUT_WIRED_HEADPHONE fails with -38 (ENOSYS) and the wired
+    // headset stays silent because the policy never marks the device
+    // connected. The vendor legacy HAL applies its own mixer paths, so
+    // nothing has to be populated here.
+    ndk::ScopedAStatus populateConnectedDevicePort(
+            ::aidl::android::media::audio::common::AudioPort* audioPort,
+            int32_t nextPortId) override;
+};
+
+class StreamInLegacy final : public StreamIn, public StreamLegacy {
+  public:
+    friend class ndk::SharedRefBase;
+    StreamInLegacy(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SinkMetadata& sinkMetadata,
+            const std::vector<::aidl::android::media::audio::common::MicrophoneInfo>& microphones)
+        : StreamIn(std::move(context), microphones),
+          StreamLegacy(&mContextInstance, sinkMetadata) {}
+
+  private:
+    void onClose(StreamDescriptor::State) override { defaultOnClose(); }
+};
+
+class StreamOutLegacy final : public StreamOut, public StreamLegacy {
+  public:
+    friend class ndk::SharedRefBase;
+    StreamOutLegacy(
+            StreamContext&& context,
+            const ::aidl::android::hardware::audio::common::SourceMetadata& sourceMetadata,
+            const std::optional<::aidl::android::media::audio::common::AudioOffloadInfo>&
+                    offloadInfo)
+        : StreamOut(std::move(context), offloadInfo),
+          StreamLegacy(&mContextInstance, sourceMetadata) {}
+
+  private:
+    void onClose(StreamDescriptor::State) override { defaultOnClose(); }
+};
+
+}  // namespace aidl::android::hardware::audio::core

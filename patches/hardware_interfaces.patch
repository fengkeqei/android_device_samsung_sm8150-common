+                V1_5::CellIdentityWcdma w;
+                w.base = ci.cellIdentityWcdma[0];
+                v15.wcdma(w);
+            }
+            break;
+        case V1_0::CellInfoType::CDMA:
+            if (ci.cellIdentityCdma.size() == 1) {
+                v15.cdma(ci.cellIdentityCdma[0]);
+            }
+            break;
+        case V1_0::CellInfoType::LTE:
+            if (ci.cellIdentityLte.size() == 1) {
+                V1_5::CellIdentityLte l;
+                l.base = ci.cellIdentityLte[0];
+                v15.lte(l);
+            }
+            break;
+        case V1_0::CellInfoType::TD_SCDMA:
+            if (ci.cellIdentityTdscdma.size() == 1) {
+                V1_5::CellIdentityTdscdma t;

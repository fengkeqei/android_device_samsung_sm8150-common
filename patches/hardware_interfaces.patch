+// ---------------------------------------------------------------------------
+// [bring-up] Samsung MDFPP TEE gatekeeper bridge
+// ---------------------------------------------------------------------------
+
+std::shared_ptr<VendorGateKeeperDevice> VendorGateKeeperDevice::create() {
+    // Avium beyond1q: this service runs from the
+    // com.android.hardware.gatekeeper.nonsecure APEX, whose linker namespace
+    // does not include /vendor/${LIB}/hw. hw_get_module_by_class() therefore
+    // always fails with ENOENT ("No vendor gatekeeper HAL module (ret=-2)")
+    // even though the patched Samsung MDFPP module is installed at
+    // /vendor/lib64/hw/gatekeeper.default.so. The software fallback then mints
+    // HATs with a non-TEE HMAC key and the fingerprint trustlet rejects them:
+    //   E bauth_FPBAuthService: BAuth_Hat_OP fail rv : 28
+    // Load the vendor module by absolute path: dlopen() with a full path skips
+    // the namespace search, and the module's own DT_NEEDED (libcrypto_gk,
+    // libQSEEComAPI, libion) resolve through the vendor namespace.
+    const hw_module_t* module = nullptr;
+    int ret = -1;
+    void* handle = dlopen("/vendor/lib64/hw/gatekeeper.default.so", RTLD_NOW | RTLD_LOCAL);
+    if (handle != nullptr) {
+        auto* hmi = static_cast<const hw_module_t*>(dlsym(handle, HAL_MODULE_INFO_SYM_AS_STR));
+        if (hmi != nullptr) {
+            module = hmi;
+            ret = 0;
+            LOG(INFO) << "Loaded vendor gatekeeper module by absolute path";
+        } else {
+            LOG(WARNING) << "gatekeeper.default.so has no HAL_MODULE_INFO_SYM";
+            dlclose(handle);
+        }
+    } else {
+        LOG(WARNING) << "dlopen(gatekeeper.default.so) failed: " << dlerror();
+    }
+    if (ret != 0 || module == nullptr) {
+        // Last resort: normal HAL lookup (succeeds when the binary runs outside
+        // the APEX namespace).
+        ret = hw_get_module_by_class(GATEKEEPER_HARDWARE_MODULE_ID, NULL, &module);
+    }
+    if (ret != 0 || module == nullptr) {
+        LOG(WARNING) << "No vendor gatekeeper HAL module (ret=" << ret
+                     << "), falling back to software gatekeeper";
+        return nullptr;
+    }
+    auto dev = ndk::SharedRefBase::make<VendorGateKeeperDevice>();
+    dev->mModule = module;
+    gatekeeper_device_t* device = nullptr;
+    ret = gatekeeper_open(module, &device);
+    if (ret != 0 || device == nullptr) {
+        LOG(WARNING) << "gatekeeper_open failed (ret=" << ret
+                     << "), falling back to software gatekeeper";
+        return nullptr;
+    }
+    dev->mDevice = device;
+    LOG(INFO) << "Vendor TEE gatekeeper HAL opened: " << module->name
+              << " author=" << module->author;
+    return dev;
+}
+
+VendorGateKeeperDevice::~VendorGateKeeperDevice() {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mDevice != nullptr) {
+        gatekeeper_close(mDevice);
+        mDevice = nullptr;
+    }
+}
+
+::ndk::ScopedAStatus VendorGateKeeperDevice::enroll(
+        int32_t uid, const std::vector<uint8_t>& currentPasswordHandle,
+        const std::vector<uint8_t>& currentPassword,
+        const std::vector<uint8_t>& desiredPassword, GatekeeperEnrollResponse* rsp) {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mDevice == nullptr) {
+        return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+    }
+    if (desiredPassword.empty()) {
+        LOG(ERROR) << "Desired password size is 0";
+        return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+    }
+
+    uint8_t* handle = nullptr;
+    uint32_t handle_len = 0;
+    int ret = mDevice->enroll(mDevice, static_cast<uint32_t>(uid),
+                              currentPasswordHandle.empty() ? nullptr
+                                                            : currentPasswordHandle.data(),
+                              currentPasswordHandle.size(),
+                              currentPassword.empty() ? nullptr : currentPassword.data(),
+                              currentPassword.size(), desiredPassword.data(),
+                              desiredPassword.size(), &handle, &handle_len);
+    if (ret == 0 && handle != nullptr && handle_len > 0) {
+        // The legacy handle is a gatekeeper::password_handle_t; the AIDL layer
+        // needs the secure user id that lives inside it.
+        int64_t secureUserId = 0;
+        if (handle_len >= sizeof(::gatekeeper::password_handle_t)) {
+            const auto* ph = reinterpret_cast<const ::gatekeeper::password_handle_t*>(handle);
+            secureUserId = static_cast<int64_t>(ph->user_id);
+        }
+        *rsp = {STATUS_OK,
+                0,
+                secureUserId,
+                std::vector<uint8_t>(handle, handle + handle_len)};
+        delete[] handle;
+        return ndk::ScopedAStatus::ok();
+    }
+    if (ret > 0) {
+        *rsp = {ERROR_RETRY_TIMEOUT, ret, 0, {}};
+        return ndk::ScopedAStatus::ok();
+    }
+    LOG(ERROR) << "vendor gatekeeper enroll failed: " << ret;
+    return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+}
+
+::ndk::ScopedAStatus VendorGateKeeperDevice::verify(
+        int32_t uid, int64_t challenge, const std::vector<uint8_t>& enrolledPasswordHandle,
+        const std::vector<uint8_t>& providedPassword, GatekeeperVerifyResponse* rsp) {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mDevice == nullptr) {
+        return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+    }
+    if (enrolledPasswordHandle.empty()) {
+        LOG(ERROR) << "Enrolled password size is 0";
+        return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+    }
+
+    uint8_t* token = nullptr;
+    uint32_t token_len = 0;
+    bool request_reenroll = false;
+    int ret = mDevice->verify(mDevice, static_cast<uint32_t>(uid),
+                              static_cast<uint64_t>(challenge), enrolledPasswordHandle.data(),
+                              enrolledPasswordHandle.size(), providedPassword.data(),
+                              providedPassword.size(), &token, &token_len, &request_reenroll);
+    if (ret == 0 && token != nullptr && token_len >= sizeof(hw_auth_token_t)) {
+        *rsp = {request_reenroll ? STATUS_REENROLL : STATUS_OK, 0, {}};
+        const auto* authToken = reinterpret_cast<const hw_auth_token_t*>(token);
+        rsp->hardwareAuthToken.challenge = authToken->challenge;
+        rsp->hardwareAuthToken.userId = authToken->user_id;
+        rsp->hardwareAuthToken.authenticatorId = authToken->authenticator_id;
+        rsp->hardwareAuthToken.authenticatorType =
+                static_cast<android::hardware::security::keymint::HardwareAuthenticatorType>(
+                        be32toh(authToken->authenticator_type));
+        rsp->hardwareAuthToken.timestamp.milliSeconds = be64toh(authToken->timestamp);
+        rsp->hardwareAuthToken.mac.assign(std::begin(authToken->hmac), std::end(authToken->hmac));
+        delete[] token;
+        return ndk::ScopedAStatus::ok();
+    }
+    if (token != nullptr) delete[] token;
+    if (ret > 0) {
+        *rsp = {ERROR_RETRY_TIMEOUT, ret, {}};
+        return ndk::ScopedAStatus::ok();
+    }
+    LOG(ERROR) << "vendor gatekeeper verify failed: " << ret;
+    return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+}
+
+::ndk::ScopedAStatus VendorGateKeeperDevice::deleteAllUsers() {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mDevice == nullptr || mDevice->delete_all_users == nullptr) {
+        return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_NOT_IMPLEMENTED));
+    }
+    return mDevice->delete_all_users(mDevice) == 0
+                   ? ndk::ScopedAStatus::ok()
+                   : ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+}
+
+::ndk::ScopedAStatus VendorGateKeeperDevice::deleteUser(int32_t uid) {
+    std::lock_guard<std::mutex> lock(mLock);
+    if (mDevice == nullptr || mDevice->delete_user == nullptr) {
+        return ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_NOT_IMPLEMENTED));
+    }
+    return mDevice->delete_user(mDevice, static_cast<uint32_t>(uid)) == 0
+                   ? ndk::ScopedAStatus::ok()
+                   : ndk::ScopedAStatus(AStatus_fromServiceSpecificError(ERROR_GENERAL_FAILURE));
+}
+
 }  // namespace aidl::android::hardware::gatekeeper

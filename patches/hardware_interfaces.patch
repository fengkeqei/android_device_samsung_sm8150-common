diff --git a/gatekeeper/aidl/software/avium.gatekeeper-service.vendor.rc b/gatekeeper/aidl/software/avium.gatekeeper-service.vendor.rc
new file mode 100644
index 0000000000..67a37a7df3
--- /dev/null
+++ b/gatekeeper/aidl/software/avium.gatekeeper-service.vendor.rc
@@ -0,0 +1,38 @@
+# Avium beyond1q: the ONLY gatekeeper service definition on the device.
+#
+# Replaces the com.android.hardware.gatekeeper.nonsecure APEX service, which
+# cannot load the Samsung MDFPP TEE module: APEX linker namespaces permit only
+# /apex/<self>, /system and /system_ext, so /vendor/lib64/hw/gatekeeper.default.so
+# is unreachable and the software fallback mints non-TEE HATs that the
+# fingerprint trustlet rejects (BAuth_Hat_OP rv 28 -> enrollment fails).
+#
+# This binary lives in /vendor/bin/hw, whose namespace does include
+# /vendor/${LIB}/hw, so GateKeeper.cpp's absolute-path dlopen succeeds.
+service vendor.gatekeeper_nonsecure /vendor/bin/hw/avium.gatekeeper-service.vendor
+    class early_hal
+    user system
+    # drmrpc (gid 1026) is required: /dev/qseecom is system:drmrpc and the TEE
+    # module opens it to reach the gatekeeper TA.
+    group system drmrpc
+    # Required so servicemanager's lazy-start can reach this service. Without
+    # the interface declaration init answers every ctl.interface_start with
+    #   Control message: Could not find
+    #   'aidl/android.hardware.gatekeeper.IGatekeeper/default'
+    # gatekeeperd never gets its HAL, BiometricService's constructor throws
+    # "IllegalStateException: Gatekeeper service not available", and
+    # system_server crash-loops before boot_completed.
+    interface aidl android.hardware.gatekeeper.IGatekeeper/default
+    # Shared-secret negotiation for keystore2 (best effort; the service logs and
+    # continues if this one cannot be registered).
+    interface aidl android.hardware.security.sharedsecret.ISharedSecret/gatekeeper
+
+# Avium beyond1q: seed the TEE-mode switch before the HAL starts.
+#
+# service.cpp reads persist.vendor.gatekeeper.soft and treats anything other
+# than "0" as "use the software gatekeeper". The property lives in
+# /data/property, so it disappears whenever /data is wiped -- which silently
+# drops the device back to the software gatekeeper and makes the fingerprint
+# trustlet reject every HAT (BAuth_Hat_OP rv 28). init can set vendor props,
+# so seed it here every boot.
+on early-init
+    setprop persist.vendor.gatekeeper.soft 0

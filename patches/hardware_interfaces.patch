+namespace aidl::android::hardware::audio::core {
+
+// [bring-up] Stream backend that talks to the vendor's legacy audio HAL
+// (audio_hw_device_t) instead of tinyalsa.
+//
+// The AOSP "example" backend drives ALSA directly.  On Samsung SM8150 that
+// opens pcmC0D0p and happily accepts frames, but nothing is ever routed to
+// the speaker amplifier: the mixer paths, ACDB calibration and DSP front-end
+// configuration all live inside the vendor legacy HAL
+// (/vendor/lib/hw/audio.primary.msmnile.so, ELF32 ARM).
+//
+// The framework in Android 16 only speaks AIDL, so this class bridges the two:
+// the AIDL worker thread calls transfer(), which calls the legacy stream's
+// write()/read().  All of the binder/FMQ/state-machine plumbing is inherited
+// from StreamCommonImpl.
+//
+// The vendor HAL is 32-bit only, so this backend is only selected when the
+// service itself is built 32-bit.  On 64-bit builds isHalAvailable() returns
+// false and ModuleLegacy falls back to the ALSA backend.
+class StreamLegacy : public StreamCommonImpl {
+  public:
+    StreamLegacy(StreamContext* context, const Metadata& metadata);
+    ~StreamLegacy() override;
+
+    // Returns true when this process can load and open the vendor legacy HAL.
+    // The result is cached; the module is only dlopen'ed on the first call.
+    static bool isHalAvailable();
+    // beyond1q: forward mic mute to the vendor legacy HAL. Module's default
+    // implementation only caches the flag, so Telecom's mute never reached
+    // the blob and the far end kept hearing the microphone.
+    static ::ndk::ScopedAStatus setLegacyMicMute(bool mute);
+
+    // Methods of 'DriverInterface'. All of them run on the worker thread.
+    ::android::status_t init(DriverCallbackInterface* callback) override;
+    ::android::status_t drain(StreamDescriptor::DrainMode mode) override;
+    ::android::status_t flush() override;
+    ::android::status_t pause() override;
+    ::android::status_t standby() override;
+    ::android::status_t start() override;
+    ::android::status_t transfer(void* buffer, size_t frameCount, size_t* actualFrameCount,
+                                 int32_t* latencyMs) override;
+    ::android::status_t refinePosition(StreamDescriptor::Position* position) override;
+    void shutdown() override;
+
+    // Methods of 'StreamCommonInterface', called on a Binder thread.
+    ndk::ScopedAStatus setGain(float gain) override;
+    ndk::ScopedAStatus setConnectedDevices(
+            const std::vector<::aidl::android::media::audio::common::AudioDevice>& devices) override;
+
+  private:
+    bool openStreamLocked();
+    void closeStreamLocked();
+    audio_devices_t getDeviceTypeLocked() const;
+    // beyond1q: address of the connected device matching the mapped type
+    // ("" for on-board ports, "bt-sco" for the SCO headset, ...). The Samsung
+    // HAL's update_device_list() stores it per stream, and it is part of how
+    // platform_get_input_snd_device() later resolves the snd_device.
+    std::string getDeviceAddressLocked() const;
+
+    const bool mIsInput;
+    const size_t mFrameSizeBytes;
+    const int mSampleRate;
+    const size_t mChannelCount;
+    audio_format_t mFormat = AUDIO_FORMAT_INVALID;
+    audio_channel_mask_t mChannelMask = static_cast<audio_channel_mask_t>(0);
+
+    std::mutex mLock;
+    // Owned by the process-wide singleton in StreamLegacy.cpp, not by us.
+    audio_hw_device_t* mDev = nullptr;
+    audio_stream_out_t* mOut = nullptr;
+    audio_stream_in_t* mIn = nullptr;
+    audio_devices_t mCurrentDevice = AUDIO_DEVICE_NONE;
+    float mGain = 1.0f;
+    // Vendor FIFO chunk size for write() (get_buffer_size()). 0 disables
+    // chunking, e.g. when the HAL has no buffer-size callback.
+    size_t mWriteChunkBytes = 0;
+    // Carries the sub-chunk tail of one AIDL burst into the next one so the
+    // HAL only ever sees full-chunk write()s.
+    std::vector<char> mPending;
+};
+
+}  // namespace aidl::android::hardware::audio::core

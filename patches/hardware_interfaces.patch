+// Avium beyond1q: V1_4 flavor of the DataProfileInfo conversion (a 1.4-only
+// radio HAL cannot accept the V1_5 struct). Same fields; ApnTypes uses the
+// V1_0 bitfield because V1_5::ApnTypes only adds NGRAN-related values that a
+// 1.4 HAL cannot consume anyway.
+V1_4::DataProfileInfo toHidlV1_4(const aidl::DataProfileInfo& info) {
+    return {
+            .profileId = static_cast<V1_0::DataProfileId>(info.profileId),
+            .apn = info.apn,
+            .protocol = static_cast<V1_4::PdpProtocolType>(info.protocol),

--- /dev/null
+++ b/audio/aidl/default/android.hardware.audio.service-aidl.rc
@@ -0,0 +1,25 @@
+service vendor.audio-hal-aidl /vendor/bin/hw/android.hardware.audio.service-aidl
+    class hal
+    # Avium v132aw: uid isolation. Same-uid (1041) cgroup kill -- when
+    # audioserver hit "exited 4 times before boot completed", init SIGKILLed
+    # cgroup system/uid_1041, which also contained this wrapper (user
+    # audioserver). The wrapper death fed audioserver's onrestart chain and
+    # the pair self-sustained a crash loop forever (wrapper alive <90s,
+    # 60x SIGKILL records; audioserver init never finished -> AudioService
+    # blocked system_server main thread -> no boot_completed). media uid
+    # (1013) + audio gid keeps device access; permissive covers label.
+    user media
+    # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
+    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct wakelock context_hub
+    capabilities BLOCK_SUSPEND SYS_NICE
+    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
+    rlimit rtprio 10 10
+    ioprio rt 4
+    # Avium v132ax: task_profiles REMOVED. This 4.14-backport kernel's cgroup v1
+    # freezer returns EACCES on /sys/fs/cgroup/system/uid_*/pid_*/cgroup.freeze
+    # writes; A16 init's SetProcessProfiles unfreeze then fails
+    # (libprocessgroup: "UnfreezeProcess failed ... 13") and init SIGKILLs the
+    # service on a strict ~90s cadence (observed pids dying at exactly +90s:
+    # 6827/7513/8027/9493/9860/10234...). Without task_profiles the service
+    # stays out of the freeze-managed cgroups and survives; audio RT scheduling
+    # loss is irrelevant for boot.

diff --git a/bluetooth/bluetooth_hal/service/service_main.cpp b/bluetooth/bluetooth_hal/service/service_main.cpp
new file mode 100644
index 0000000000..0d84d89ba8
--- /dev/null
+++ b/bluetooth/bluetooth_hal/service/service_main.cpp
@@ -0,0 +1,60 @@
+/*
+ * [bring-up] Bluetooth HCI HAL service backed by AOSP's bluetooth_hal.
+ *
+ * Why this exists
+ * ---------------
+ * Android 16's Bluetooth stack (GD) talks to the controller through the AIDL
+ * interface android.hardware.bluetooth.IBluetoothHci. The reference
+ * implementation under hardware/interfaces/bluetooth/aidl/default only drives
+ * an emulator-style /dev/hvc5 and does no chip bring-up, which on this device
+ * (Broadcom BCM4375 behind /dev/ttyHS0) leaves the controller unpowered: the
+ * stack's first HCI access hard-hangs the AP.
+ *
+ * AOSP also ships a production-grade implementation,
+ * hardware/interfaces/bluetooth/bluetooth_hal, that does the whole job:
+ *   - transport/uart_h4/transport_uart_h4.cc   UART H4 framing over a tty
+ *   - chip/chip_provisioner.cc                 Broadcom VSC firmware download
+ *   - config/hal_config_loader.cc              reads /vendor/etc/bluetooth/hal_config.json
+ *   - rfkill lookup by type "bluetooth"        powers BT_EN through the kernel
+ *                                              driver (bcm4361.c registers
+ *                                              rfkill0 "bcm4361 Bluetooth")
+ * It has no service entry point of its own -- libbluetooth_hal is a static
+ * library with zero consumers in the tree. This file is that entry point.
+ *
+ * The class HciProxyAidl already implements every IBluetoothHci method, so the
+ * service is just registration plus a thread pool.
+ */
+
+#define LOG_TAG "android.hardware.bluetooth.service.bt"
+
+#include <android-base/logging.h>
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+#include "aidl/android/hardware/bluetooth/IBluetoothHci.h"
+#include "bluetooth_hal/hci_proxy_aidl.h"
+
+using ::aidl::android::hardware::bluetooth::IBluetoothHci;
+using ::bluetooth_hal::HciProxyAidl;
+
+int main(int /* argc */, char** /* argv */) {
+    LOG(INFO) << "Bluetooth HCI HAL (bluetooth_hal backend) starting";
+
+    if (!ABinderProcess_setThreadPoolMaxThreadCount(0)) {
+        LOG(ERROR) << "failed to set thread pool max thread count";
+        return 1;
+    }
+
+    auto service = ndk::SharedRefBase::make<HciProxyAidl>();
+    const std::string instance = std::string(IBluetoothHci::descriptor) + "/default";
+    binder_status_t status =
+        AServiceManager_addService(service->asBinder().get(), instance.c_str());
+    if (status != STATUS_OK) {
+        LOG(ERROR) << "failed to register " << instance << " (" << status << ")";
+        return 1;
+    }
+    LOG(INFO) << "registered " << instance;
+
+    ABinderProcess_joinThreadPool();
+    return 0;
+}

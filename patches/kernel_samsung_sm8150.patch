diff --git a/drivers/platform/msm/ipa/ipa_v3/ipa.c b/drivers/platform/msm/ipa/ipa_v3/ipa.c
index f2b42ad32..2e5fb6757 100755
--- a/drivers/platform/msm/ipa/ipa_v3/ipa.c
+++ b/drivers/platform/msm/ipa/ipa_v3/ipa.c
@@ -6650,7 +6650,13 @@ static void ipa3_load_ipa_fw(struct work_struct *work)
 	if (result) {
 		IPAERR("IPA FW loading process has failed result=%d\n",
 			result);
-		ipa_assert();
+		/* v132: WARN instead of ipa_assert(). PIL-TZ rejects
+		 * ipa_fws.mdt with rc:-22 (Turing init-image SCM call) on the
+		 * 4.14.357-openela base, and the assert turned that into a
+		 * kernel BUG -> sec_debug reboot loop. IPA hardware is unused
+		 * on this board (Broadcom dhd has no IPA offload dependency),
+		 * so a failed firmware load is non-fatal here. */
+		WARN_ON(1);
 		return;
 	}
 	pr_info("IPA FW loaded successfully\n");

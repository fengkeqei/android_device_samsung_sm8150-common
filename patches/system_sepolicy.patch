diff --git a/private/hal_audio.te b/private/hal_audio.te
index 237ffcd7c..c19c69311 100644
--- a/private/hal_audio.te
+++ b/private/hal_audio.te
@@ -9,7 +9,6 @@ allow hal_audio ion_device:chr_file r_file_perms;
 
 binder_call(hal_audio_server, servicemanager)
 
-r_dir_file(hal_audio, proc)
 r_dir_file(hal_audio, proc_asound)
 allow hal_audio_server audio_device:dir r_dir_perms;
 allow hal_audio_server audio_device:chr_file rw_file_perms;
@@ -29,7 +28,10 @@ allow hal_audio_server system_server_tmpfs:file { getattr map read };
 allow hal_audio_server self:global_capability_class_set sys_nice;
 
 # allow hal audio to use vnbinder
-vndbinder_use(hal_audio)
+# Avium beyond1q: excluded for the system-domain twins (avium_audio /
+# avium_audioeffect): they register on /dev/binder, and granting vndbinder to
+# a coredomain trips the vndbinder_device neverallow in domain.te.
+vndbinder_use({ hal_audio -avium_audio -avium_audioeffect })
 
 ###
 ### neverallow rules
@@ -44,3 +46,67 @@ neverallow { halserverdomain -hal_audio_server -hal_omx_server } audio_device:ch
 get_prop(hal_audio, audio_config_prop)
 get_prop(hal_audio, bluetooth_a2dp_offload_prop)
 get_prop(hal_audio, bluetooth_audio_hal_prop)
+
+# Avium beyond1q: system-domain audio HAL twins (android.hardware.audio.
+# service-aidl.avium + android.hardware.audio.effect.service-aidl.avium,
+# labeled avium_audio_exec / avium_audioeffect_exec). No vendor-AIDL bridge on
+# this bp4a base, so they register on /dev/binder as coredomain hal_server
+# domains, like avium_health/avium_light/avium_power/avium_keymint.
+type avium_audio, domain;
+typeattribute avium_audio coredomain;
+hal_server_domain(avium_audio, hal_audio)
+init_daemon_domain(avium_audio)
+binder_use(avium_audio)
+
+type avium_audioeffect, domain;
+typeattribute avium_audioeffect coredomain;
+hal_server_domain(avium_audioeffect, hal_audio)
+init_daemon_domain(avium_audioeffect)
+binder_use(avium_audioeffect)
+
+# Avium beyond1q: avium_audio must load the vendor legacy audio HAL.
+#
+# StreamLegacy::getLegacyDevice() calls hw_get_module_by_class("audio",
+# "primary"), which dlopens /vendor/lib/hw/audio.primary.msmnile.so. That is a
+# vendor_file, and coredomain (where avium_audio lives) has no read access to
+# vendor_file by default, so the lookup fails with ENOENT:
+#   E AHAL_StreamLegacy: getLegacyDevice: hw_get_module_by_class(audio.primary) failed: -2
+#   avc: denied { getattr } path="/vendor/lib/hw/audio.primary.msmnile.so"
+#        scontext=u:r:avium_audio:s0 tcontext=u:object_r:vendor_file:s0
+# ModuleLegacy then falls back to the AOSP ALSA backend:
+#   W AHAL_ModuleLegacy: createOutputStream: FALLBACK to ALSA (isHalAvailable=0)
+# That backend opens pcm0p, which on this board is not routed to the CS35L41
+# speakers, so playback silently drops:
+#   W AHAL_StreamAlsa: outputIoThread[0]: Error writing into ALSA: -1
+# With these grants the Samsung route (mixer_paths_tavil -> ADSP -> CS35L41) is
+# used again, exactly as in BUILD_NOTES section 35.
+# No `execute`: coredomain must not execute vendor_file (domain.te neverallow),
+# and dlopen()ing a shared object only needs open/read/map.
+allow avium_audio vendor_file:dir r_dir_perms;
+allow avium_audio vendor_file:file { getattr open read map };
+allow avium_audio vendor_hal_file:dir r_dir_perms;
+allow avium_audio vendor_hal_file:file { getattr open read map };
+
+# The vendor audio HAL's transitive dependencies are labeled
+# same_process_hal_file (LLNDK-style / vendor HAL libs), not vendor_file:
+#   avc: denied { open } path="/vendor/lib/libbase.so"
+#        tcontext=u:object_r:same_process_hal_file:s0
+# Without it the dlopen chain aborts with
+#   vndksupport: Could not load /vendor/lib/hw/audio.primary.msmnile.so from
+#   sphal namespace: dlopen failed: library "libbase.so" not found
+# and ModuleLegacy falls back to ALSA (silent, unrouted pcm0p).
+# `execute` is required: the dynamic linker maps the last segment of each
+# dependency with PROT_EXEC, and without it every load fails with
+#   dlopen failed: couldn't map "/vendor/lib/libbase.so" segment 2:
+#   Permission denied
+# same_process_hal_file is the one vendor-side type coredomain may execute
+# (app.te and hal_graphics_allocator.te do the same), so the audio HAL's
+# dependency closure is labelled with it in the device file_contexts.
+allow avium_audio same_process_hal_file:file { getattr open read map execute };
+allow avium_audio same_process_hal_file:dir r_dir_perms;
+
+# CS35L41 speaker protection reads its factory calibration blob.
+#   avc: denied { open } path="/efs/cirrus/rdc_cal_r"
+#        tcontext=u:object_r:efs_file:s0
+allow avium_audio efs_file:dir r_dir_perms;
+allow avium_audio efs_file:file { getattr open read };

-allow hal_health_server bpfloader:bpf prog_run;
+# Avium v132bw20: removed - with avium_health holding the hal_health_server attribute this
+# AOSP line cascades bpf prog_run to it and trips bpfdomain.te neverallow (bpf is
+# whitelisted domains only). The apex health implementation gets this from its own
+# apex sepolicy; the system-domain avium HAL does not use bpf.
+
+# Avium beyond1q v132bw12: daemonize the coredomain health server so the
+# system-domain avium health HAL (android.hardware.health-service.avium,
+# labeled hal_health_server_exec above) can start and register IHealth.
+# neverallow { domain -hal_health_server } hal_health_service:service_manager add
+# makes this the ONLY legal domain for the registration.
+# Avium beyond1q v132bw16: define a real coredomain type for the system-domain
+# health HAL (android.hardware.health-service.avium) and tag it with the
+# hal_health_server ATTRIBUTE - the neverallow
+#   neverallow { domain -hal_health_server } hal_health_service:service_manager add
+# whitelists by attribute, and A16 only defines the apex's own type, so we
+# declare ours here.
+type avium_health, domain;
+typeattribute avium_health coredomain;
+# v132bw22: the AOSP macro way - grants halserverdomain (fork neverallow
+# exclusion), hal_health_server (add neverallow exclusion) and hal_health.
+hal_server_domain(avium_health, hal_health)
+init_daemon_domain(avium_health)
+binder_use(avium_health)
+allow avium_health sysfs_batteryinfo:dir r_dir_perms;
+allow avium_health sysfs_batteryinfo:file r_file_perms;
+# Samsung labels /sys/class/power_supply as sysfs_battery, a vendor-private
+# type that plat policy cannot name. The type carries the shared sysfs_type
+# attribute, which plat policy CAN use, so grant the same read access through
+# it. Without this, BatteryMonitor::init() logs
+#   healthd: Could not open /sys/class/power_supply
+#   healthd: No battery devices found
+# and BatteryService reports present=false / level=0 / voltage=0.
+allow avium_health sysfs_type:dir r_dir_perms;
+allow avium_health sysfs_type:file r_file_perms;
+allow avium_health kmsg_device:chr_file { getattr w_file_perms };
+allow avium_health same_process_hal_file:dir r_dir_perms;
+get_prop(avium_health, exported_system_prop)
+set_prop(avium_health, exported_system_prop)
+

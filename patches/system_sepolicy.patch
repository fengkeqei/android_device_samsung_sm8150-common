+# avium_supplicant a member of hal_wifi_supplicant, but the attribute-scoped
+# `allow hal_wifi_supplicant self:...` rules above are expanded per-type at
+# compile time only for the types declared in the same module, so the twin
+# domain needs its own copy of the driver-facing socket permissions.
+allow avium_supplicant self:netlink_route_socket { bind create read write nlmsg_read nlmsg_write nlmsg_readpriv };
+allowxperm avium_supplicant self:netlink_route_socket nlmsg priv_route_socket_nlmsgs;
+allow avium_supplicant self:netlink_generic_socket create_socket_perms_no_ioctl;
+allow avium_supplicant self:netlink_socket create_socket_perms_no_ioctl;
+allow avium_supplicant self:packet_socket create_socket_perms;
+allowxperm avium_supplicant self:packet_socket ioctl { unpriv_sock_ioctls priv_sock_ioctls unpriv_tty_ioctls };
+allow avium_supplicant self:udp_socket create_socket_perms;
+allowxperm avium_supplicant self:udp_socket ioctl priv_sock_ioctls;
+allow avium_supplicant self:global_capability_class_set { net_admin net_raw setuid setgid };
+allow avium_supplicant sysfs_net:dir search;
+allow avium_supplicant sysfs_type:dir r_dir_perms;
+allow avium_supplicant sysfs_type:file r_file_perms;
+allow avium_supplicant proc_net_type:dir r_dir_perms;
+allow avium_supplicant proc_net_type:file r_file_perms;

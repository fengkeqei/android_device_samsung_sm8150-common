+
+# Avium beyond1q: system-domain wpa_supplicant twin. The AIDL ISupplicant
+# service must register on /dev/binder (no vendor-AIDL bridge on this bp4a
+# base), so wpa_supplicant runs as a coredomain hal_server_domain like
+# avium_health/avium_light/avium_power/avium_keymint.
+type avium_supplicant, domain;
+typeattribute avium_supplicant coredomain;
+hal_server_domain(avium_supplicant, hal_wifi_supplicant)
+init_daemon_domain(avium_supplicant)
+binder_use(avium_supplicant)
+get_prop(avium_supplicant, exported_system_prop)
+set_prop(avium_supplicant, exported_system_prop)
+
+# avium_supplicant is a plat/coredomain domain, so it cannot touch
+# /data/vendor/wifi (vendor-private wifi_vendor_data_file). Give it a
+# plat-visible state directory instead - the same shape AOSP uses for
+# wifi_mainline_supplicant. supplicant.cpp is compiled with
+# -DAVIUM_SYSTEM_SUPPLICANT so it points at /data/misc/wifi/avium_supplicant.
+type avium_supplicant_data_file, file_type, data_file_type, core_data_file_type;
+
+# Parent directory only needs search so the child can be resolved.
+allow avium_supplicant wifi_data_file:dir { getattr search };
+
+allow avium_supplicant avium_supplicant_data_file:dir create_dir_perms;
+allow avium_supplicant avium_supplicant_data_file:file create_file_perms;
+allow avium_supplicant avium_supplicant_data_file:sock_file { create write setattr unlink };
+
+# The control socket created by `socket wpa_wlan0 dgram 660 wifi wifi` in
+# wifi_supplicant_avium.rc, plus the per-interface ctrl sockets.
+allow avium_supplicant wpa_socket:sock_file create_file_perms;
+allow avium_supplicant wpa_socket:dir rw_dir_perms;
+allow avium_supplicant system_wpa_socket:sock_file create_file_perms;

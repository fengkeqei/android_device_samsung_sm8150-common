diff --git a/media/audioserver/audioserver.rc b/media/audioserver/audioserver.rc
index 0a8efbde82..577f21780f 100644
--- a/media/audioserver/audioserver.rc
+++ b/media/audioserver/audioserver.rc
@@ -6,9 +6,18 @@ service audioserver /system/bin/audioserver
     capabilities BLOCK_SUSPEND WAKE_ALARM
     # match rtprio cur / max with sensor service as we handle AR/VR HID sensor data.
     rlimit rtprio 10 10
-    ioprio rt 4
-    task_profiles ProcessCapacityHigh HighPerformance
-    onrestart restart vendor.audio-hal
+    # v132fix: 4.14 cgroup v1 has no cgroup.freeze -> init SIGKILLs this
+    # service every cycle. Stripped.
+    #ioprio rt 4
+    # v132fix: 4.14 cgroup v1 has no cgroup.freeze -> init SIGKILLs this
+    # service every cycle. Stripped.
+    #task_profiles ProcessCapacityHigh HighPerformance
+    # avium: vendor.audio-hal is the legacy HIDL service. It is built 64-bit
+    # in this image and cannot load the 32-bit Samsung audio.primary blob;
+    # every start aborted, which made init restart audioserver and vice
+    # versa (5-second mutual kill loop, no audio at all). Its service
+    # definition is removed from init.qcom.rc; do not reference it here.
+    # onrestart restart vendor.audio-hal
     onrestart restart vendor.audio-hal-aidl
     onrestart restart vendor.audio-effect-hal-aidl
     onrestart restart vendor.audio-hal-4-0-msd
@@ -20,7 +29,7 @@ on property:vts.native_server.on=0
     start audioserver
 
 on property:init.svc.audioserver=stopped
-    stop vendor.audio-hal
+    # avium: no vendor.audio-hal (see the note above the onrestart lines).
     stop vendor.audio-hal-aidl
     stop vendor.audio-effect-hal-aidl
     stop vendor.audio-hal-4-0-msd
@@ -28,7 +37,6 @@ on property:init.svc.audioserver=stopped
     # See b/155364397. Need to have HAL service running for VTS.
     # Can't use 'restart' because then HAL service would restart
     # audioserver bringing it back into running state.
-    start vendor.audio-hal
     start vendor.audio-hal-aidl
     start vendor.audio-effect-hal-aidl
     start vendor.audio-hal-4-0-msd
@@ -41,7 +49,7 @@ on property:init.svc.audioserver=running && property:vts.native_server.on=1
     stop audioserver
 
 on property:init.svc.audioserver=running
-    start vendor.audio-hal
+    # avium: no vendor.audio-hal (see the note above the onrestart lines).
     start vendor.audio-hal-aidl
     start vendor.audio-effect-hal-aidl
     start vendor.audio-hal-4-0-msd
@@ -50,12 +58,11 @@ on property:init.svc.audioserver=running
 on property:sys.audio.restart.hal=1
     # See b/159966243. Avoid restart loop between audioserver and HAL.
     # Keep the original service names for backward compatibility
-    stop vendor.audio-hal
+    # avium: no vendor.audio-hal (see the note above the onrestart lines).
     stop vendor.audio-hal-aidl
     stop vendor.audio-effect-hal-aidl
     stop vendor.audio-hal-4-0-msd
     stop audio_proxy_service
-    start vendor.audio-hal
     start vendor.audio-hal-aidl
     start vendor.audio-effect-hal-aidl
     start vendor.audio-hal-4-0-msd

diff --git a/media/codec2/vndk/include/C2PlatformStorePluginLoader.h b/media/codec2/vndk/include/C2PlatformStorePluginLoader.h
index 73d1b5e839..8b5f5797ac 100644
--- a/media/codec2/vndk/include/C2PlatformStorePluginLoader.h
+++ b/media/codec2/vndk/include/C2PlatformStorePluginLoader.h
@@ -83,10 +83,35 @@ public:
      * \retval C2_BAD_INDEX the input allocatorId is not defined in platform store extension.
      * \retval C2_NO_MEMORY not enough memory to create the allocator
      */
+    // [bring-up] NOTE: the deleter argument is no longer defaulted. It used to
+    // have = std::default_delete<C2Allocator>(), which makes a two-argument
+    // call ambiguous once the Android 11 overload below exists
+    // (C2Store.cpp:174 does exactly that):
+    //   error: call to member function 'createAllocator' is ambiguous
+    // Callers inside the platform now pass the deleter explicitly; vendor blobs
+    // keep using the two-argument overload, which forwards here.
     c2_status_t createAllocator(
             ::C2Allocator::id_t allocatorId,
             std::shared_ptr<C2Allocator>* const allocator,
-            std::function<void(C2Allocator *)> deleter = std::default_delete<C2Allocator>());
+            std::function<void(C2Allocator *)> deleter);
+
+    // [bring-up] Android 11 signatures, kept for vendor blobs compiled before
+    // the deleter parameter existed. Samsung's libSecC2ComponentStore.so
+    // (samsung.software.media.c2@1.0-service) references
+    //   _ZN27C2PlatformStorePluginLoader15createAllocatorEjPNSt3__110shared_ptrI11C2AllocatorEE
+    //   _ZN27C2PlatformStorePluginLoader15createBlockPoolEjmPNSt3__110shared_ptrI11C2BlockPoolEE
+    // which A16 no longer exports (both gained a trailing std::function
+    // deleter). Without them the service fails to link:
+    //   cannot locate symbol
+    //   "_ZN27C2PlatformStorePluginLoader15createAllocatorEjPNSt3__110shared_ptrI11C2AllocatorEE"
+    //   referenced by "/vendor/lib64/libSecC2ComponentStore.so"
+    // Nothing in the platform calls these two-argument forms.
+    c2_status_t createAllocator(
+            ::C2Allocator::id_t allocatorId,
+            std::shared_ptr<C2Allocator>* const allocator);
+    c2_status_t createBlockPool(
+            ::C2Allocator::id_t allocatorId, ::C2BlockPool::local_id_t blockPoolId,
+            std::shared_ptr<C2BlockPool>* pool);
 
 private:
     explicit C2PlatformStorePluginLoader(const char *libPath);
